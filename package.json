{
  "name": "enigma",
  "version": "1.1.0",
  "description": "Monorepo for enigma: tooling to work with coding agents. The publishable CLI lives in packages/enigma-cli.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "enigma": "npm run -w enigma-cli enigma --",
    "dev": "npm run -w enigma-cli dev --",
    "dev:bun": "npm run -w enigma-cli dev:bun --",
    "dashboard:preview": "node scripts/dashboard-preview.mjs",
    "sync:helio": "node scripts/sync-helio.mjs",
    "build": "npm run -w enigma-cli build",
    "check:hooks": "node scripts/check-hook-drift.mjs",
    "check:vendor": "node scripts/sync-primitives.mjs --check",
    "typecheck": "npm run -w enigma-cli typecheck",
    "typecheck:all": "npm run -w enigma-cli typecheck && npm run -w @enigmax/primitives typecheck && npm run -w @enigmax/utils typecheck",
    "build:components": "npm run -w @enigmax/primitives build && npm run -w @enigmax/utils build",
    "test:utils": "npm run -w @enigmax/utils test",
    "test:primitives": "npm run -w @enigmax/primitives test",
    "seal": "node scripts/sync-registry.mjs && node scripts/sync-primitives.mjs && npm run -w enigma-cli seal",
    "sync:registry": "node scripts/sync-registry.mjs",
    "sync:primitives": "node scripts/sync-primitives.mjs",
    "check": "npm run -w enigma-cli check",
    "guard": "npm run -w enigma-cli guard",
    "guardrails": "npm run -w enigma-cli guardrails",
    "verify": "npm run -w enigma-cli verify",
    "lint": "npm run -w @enigmax/linter dev --",
    "lint:test": "npm run -w @enigmax/linter test",
    "lint:changed": "tsx scripts/lint-changed.mjs",
    "trim": "npm run -w enigma-cli trim"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "FJRG2007 <fjrg2007@tpeoficial.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FJRG2007/enigma.git"
  },
  "homepage": "https://github.com/FJRG2007/enigma#readme",
  "bugs": {
    "url": "https://github.com/FJRG2007/enigma/issues"
  }
}
