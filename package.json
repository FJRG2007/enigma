{
  "name": "enigma",
  "version": "1.0.0",
  "description": "Monorepo for enigma: tooling to work with coding agents. The publishable CLI lives in packages/enigma-cli.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "enigma": "node packages/enigma-cli/bin/enigma.mjs",
    "seal": "node packages/enigma-cli/bin/enigma.mjs seal",
    "check": "node --check packages/enigma-cli/bin/enigma.mjs && node packages/enigma-cli/bin/enigma.mjs check",
    "guard": "node packages/enigma-cli/lib/guard.mjs --all",
    "verify": "npm run check && npm run guard"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "FJRG2007 <fjrg2007@tpeoficial.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FJRG2007/enigma.git"
  },
  "homepage": "https://github.com/FJRG2007/enigma#readme",
  "bugs": {
    "url": "https://github.com/FJRG2007/enigma/issues"
  }
}