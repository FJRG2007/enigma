---
import Tabs from "./Tabs.astro";
import Command from "./Command.astro";

/**
 * The installation block every component page carries: the one-command route first, the
 * by-hand route behind a tab for anyone who does not use enigma or wants to read what it
 * would have done.
 *
 * The manual side is deliberately the real steps, not a link away - a reader who chose
 * "Manual" has already said they want to see it.
 */
interface Props {
    /** Registry item id, e.g. "marquee". Omitted for a whole-package block. */
    item?: string;
    pkg: string;
    /** Extra packages the item declares, installed with it. */
    deps?: string[];
    /** Import line the component is used through. */
    entry?: string;
}
const { item, pkg, deps = [], entry } = Astro.props;

const packages = [pkg, ...deps].join(" ");

// Written out rather than mapped: `slot={expression}` is not supported either, so the
// slot names have to be literals. Four package managers is a closed set anyway.
const MANAGERS = [
    { id: "npm", label: "npm" },
    { id: "pnpm", label: "pnpm" },
    { id: "yarn", label: "yarn" },
    { id: "bun", label: "bun" }
];
---
<Tabs tabs={[{ id: "cli", label: "Auto" }, { id: "manual", label: "Manual" }]} frame={false}>
    <div slot="cli">
        <p class="in-lead">Adds the package and prints the import to use. Append <code>--copy</code> to write the source into your project instead.</p>
        <Command command={item ? `enigma add ${item}` : "enigma add --all"} />
        {deps.length > 0 && (
            <p class="in-note">Brings <strong>{deps.join(", ")}</strong> with it. <code>--no-deps</code> leaves them out.</p>
        )}
        <p class="in-note">Installs with your project's own package manager - npm, pnpm, yarn or bun - read from its <code>packageManager</code> field or its lockfile.</p>
    </div>

    <div slot="manual">
        <p class="in-step"><span class="in-num">1</span> Install the dependencies</p>
        <Tabs tabs={MANAGERS} persist="package-manager" flush={true}>
            <div slot="npm"><Command command={`npm install ${packages}`} bare={true} /></div>
            <div slot="pnpm"><Command command={`pnpm add ${packages}`} bare={true} /></div>
            <div slot="yarn"><Command command={`yarn add ${packages}`} bare={true} /></div>
            <div slot="bun"><Command command={`bun add ${packages}`} bare={true} /></div>
        </Tabs>

        <p class="in-step"><span class="in-num">2</span> Use it</p>
        {entry && <p class="in-lead">Import from <code>{entry}</code>.</p>}
        <slot name="manual" />
    </div>
</Tabs>

<style>
    .in-lead { margin: 0 0 12px; font-size: 13.5px; color: var(--muted); }
    .in-note { margin: 10px 0 0; font-size: 12.5px; color: var(--muted); }
    .in-step { display: flex; align-items: center; gap: 9px; margin: 20px 0 10px; font-size: 13.5px; color: var(--text); }
    .in-step:first-child { margin-top: 0; }
    .in-num { display: inline-grid; place-items: center; width: 20px; height: 20px; flex: 0 0 auto; font-family: var(--mono); font-size: 11px; color: var(--accent); background: var(--surface2); border: 1px solid var(--border); border-radius: 999px; }
</style>
