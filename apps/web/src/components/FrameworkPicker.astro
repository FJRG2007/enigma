---
<div class="fw" data-framework-picker>
    <span class="fw-l" id="fw-label">Code examples in</span>
    <button type="button" class="fw-b" data-framework-toggle aria-haspopup="listbox" aria-expanded="false" aria-labelledby="fw-label fw-current">
        <svg class="fw-i" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-framework-mark><path d={FRAMEWORKS[0].path}></path></svg>
        <span class="fw-t" id="fw-current">{FRAMEWORKS[0].label}</span>
        <svg class="fw-c" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
    </button>
    <ul class="fw-list" role="listbox" aria-labelledby="fw-label" data-framework-list hidden>
        {FRAMEWORKS.map((framework, index) => (
            <li>
                <button type="button" role="option" aria-selected={index === 0 ? "true" : "false"} data-framework={framework.id} data-path={framework.path}>
                    <svg class="fw-i" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={framework.path}></path></svg>
                    <span>{framework.label}</span>
                </button>
            </li>
        ))}
    </ul>
</div>

<style>
    .fw { position: relative; display: grid; gap: 7px; padding-bottom: 18px; border-bottom: 1px solid var(--border-soft); }
    .fw-l { font-family: var(--mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: .6px; color: var(--muted); }
    .fw-i { width: 14px; height: 14px; flex: 0 0 auto; }
    .fw-b {
        display: flex; align-items: center; gap: 8px; width: 100%;
        font-family: var(--mono); font-size: 12.5px; color: var(--text); text-align: left;
        background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
        padding: 7px 10px; cursor: pointer;
    }
    .fw-b:hover { border-color: var(--muted); }
    .fw-t { flex: 1; min-width: 0; }
    .fw-c { width: 13px; height: 13px; flex: 0 0 auto; color: var(--muted); }

    .fw-list {
        position: absolute; z-index: 40; top: calc(100% - 8px); left: 0; right: 0;
        margin: 0; padding: 4px; list-style: none;
        background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
        box-shadow: 0 18px 40px -22px rgba(0, 0, 0, 0.9);
    }
    .fw-list[hidden] { display: none; }
    .fw-list button {
        display: flex; align-items: center; gap: 8px; width: 100%;
        font-family: var(--mono); font-size: 12.5px; color: var(--muted); text-align: left;
        background: transparent; border: 0; border-radius: 7px; padding: 7px 8px; cursor: pointer;
    }
    .fw-list button:hover, .fw-list button.is-active { color: var(--text); background: var(--surface2); }
    .fw-list button[aria-selected="true"] { color: var(--accent); }
</style>

<script>
    const KEY = "enigma:tabs:framework";
    const picker = document.querySelector<HTMLElement>("[data-framework-picker]");

    if (picker) {
        const toggle = picker.querySelector<HTMLButtonElement>("[data-framework-toggle]")!;
        const list = picker.querySelector<HTMLElement>("[data-framework-list]")!;
        const options = [...list.querySelectorAll<HTMLButtonElement>("[data-framework]")];
        const currentMark = picker.querySelector<SVGPathElement>("[data-framework-mark] path")!;
        const currentText = picker.querySelector<HTMLElement>("#fw-current")!;

        function select(wanted: string, announce: boolean): void {
            const option = options.find((candidate) => candidate.dataset.framework === wanted);
            // A stored value the list no longer has would leave the control blank over a
            // page showing something else.
            if (!option) return;

            for (const candidate of options) candidate.setAttribute("aria-selected", String(candidate === option));
            currentMark.setAttribute("d", option.dataset.path ?? "");
            currentText.textContent = option.textContent?.trim() ?? wanted;

            if (!announce) return;
            localStorage.setItem(KEY, wanted);
            // Tabs owns the panels; it listens for this rather than exporting its internals.
            document.dispatchEvent(new CustomEvent("enigma:tabs", { detail: { key: "framework", value: wanted } }));
        }

        function open(next: boolean): void {
            list.hidden = !next;
            toggle.setAttribute("aria-expanded", String(next));
            if (next) options.find((option) => option.getAttribute("aria-selected") === "true")?.focus();
        }

        const stored = localStorage.getItem(KEY);
        if (stored) select(stored, false);

        toggle.addEventListener("click", () => open(list.hidden));
        for (const option of options) {
            option.addEventListener("click", () => {
                select(option.dataset.framework ?? "react", true);
                open(false);
                toggle.focus();
            });
        }

        picker.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && !list.hidden) { open(false); toggle.focus(); return; }
            if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
            if (list.hidden) { open(true); event.preventDefault(); return; }
            const at = options.indexOf(document.activeElement as HTMLButtonElement);
            const step = event.key === "ArrowDown" ? 1 : -1;
            // Wraps, so holding one arrow never dead-ends at an edge.
            options[(at + step + options.length) % options.length]?.focus();
            event.preventDefault();
        });

        // A menu that stays open after a click elsewhere is a menu covering the page.
        document.addEventListener("click", (event) => {
            if (!list.hidden && !picker.contains(event.target as Node)) open(false);
        });
    }
</script>
