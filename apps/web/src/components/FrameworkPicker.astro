---
/**
 * The stack a reader works in, picked ONCE and remembered.
 *
 * It sits in the on-this-page column beside the source links rather than on each code
 * block, for the reason a reader would give: their stack does not change between the Usage
 * section and the Installation section, so being asked again at every block is a question
 * with a known answer. Every `<Frameworks>` on the page follows this, and the choice
 * survives a reload and every navigation.
 */
const FRAMEWORKS = [
    { id: "react", label: "React" },
    { id: "next", label: "Next.js" },
    { id: "vanilla", label: "Vanilla" },
    { id: "astro", label: "Astro" }
];
---
<div class="fw" data-framework-picker>
    <label class="fw-l" for="fw-select">Code examples in</label>
    <div class="fw-w">
        <select id="fw-select" class="fw-s" data-framework-select>
            {FRAMEWORKS.map((framework) => <option value={framework.id}>{framework.label}</option>)}
        </select>
        <svg class="fw-c" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
    </div>
</div>

<style>
    .fw { display: grid; gap: 7px; padding-bottom: 18px; border-bottom: 1px solid var(--border-soft); }
    .fw-l { font-family: var(--mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: .6px; color: var(--muted); }
    .fw-w { position: relative; display: block; }
    .fw-s {
        width: 100%;
        font-family: var(--mono); font-size: 12.5px; color: var(--text);
        background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
        padding: 7px 30px 7px 10px; cursor: pointer;
        /* The native arrow sits at a different offset per platform and does not take a
           colour, so it goes and the chevron below takes its place. */
        appearance: none;
    }
    .fw-s:hover { border-color: var(--muted); }
    /* An option list is drawn by the OS: on a dark page the default is white-on-white in
       some browsers unless both are stated. */
    .fw-s option { background: var(--surface); color: var(--text); }
    .fw-c { position: absolute; top: 50%; right: 10px; width: 13px; height: 13px; margin-top: -6.5px; color: var(--muted); pointer-events: none; }
</style>

<script>
    const KEY = "enigma:tabs:framework";
    const selects = [...document.querySelectorAll<HTMLSelectElement>("[data-framework-select]")];

    const stored = localStorage.getItem(KEY);
    // A stored value the list no longer has would leave the control blank while the page
    // shows something else.
    if (stored && selects[0]?.querySelector(`option[value="${stored}"]`)) {
        for (const select of selects) select.value = stored;
    }

    for (const select of selects) {
        select.addEventListener("change", () => {
            localStorage.setItem(KEY, select.value);
            for (const other of selects) other.value = select.value;
            // Tabs owns the panels; it listens for this rather than exporting its internals,
            // so neither file has to know how the other is built.
            document.dispatchEvent(new CustomEvent("enigma:tabs", { detail: { key: "framework", value: select.value } }));
        });
    }
</script>
