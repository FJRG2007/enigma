---
// Reusable install-method picker: tabs (curl / powershell / npm / pnpm / yarn / bun / npx) and
// a copy button, sharing the single source of truth in lib/shell.ts with the landing and
// /start. The tab matching the visitor's OS is preselected and marked "recommended".
//
// Uses <code> (not <pre>) for the command so the docs' global ".doc pre" styling and its
// copy-button script never touch it - this widget brings its own copy button.
import { INSTALL_METHODS } from "../lib/shell";

interface Props {
    // When set, the page navigates here after a successful copy (the landing -> /start flow).
    next?: string;
}
const { next } = Astro.props;
const methods = Object.keys(INSTALL_METHODS); // curl, powershell, npm, pnpm, yarn, bun, npx
// The OS script tabs can each be the recommended one; the server picks curl, the client
// moves the mark to powershell on Windows by flipping `data-rec`, never by inserting markup.
const recommendable = new Set(["curl", "powershell"]);
---
<div class="install-tabs" data-next={next ?? ""}>
    <div class="it-tabs" role="tablist" aria-label="Install method">
        {methods.map((m, i) => (
            <button
                type="button"
                role="tab"
                class={i === 0 ? "active" : ""}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                data-cmd={m}
                data-rec={m === "curl" ? "" : undefined}
                aria-label={m}
            >
                <span class="it-name">{m}</span>
                {recommendable.has(m) && <span class="it-rec" aria-hidden="true">recommended</span>}
            </button>
        ))}
    </div>
    <div class="it-row" role="tabpanel">
        <code class="it-text">{INSTALL_METHODS.curl}</code>
        <button class="it-copy" type="button" title="Copy command" aria-label="Copy command">
            <svg class="ic-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="ic-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </button>
    </div>
</div>

<style>
    .install-tabs { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-2); overflow: hidden; text-align: left; margin: 18px 0; }
    .it-tabs { display: flex; flex-wrap: wrap; gap: 4px; padding: 8px; background: var(--inset); border-bottom: 1px solid var(--border-soft); }
    .it-tabs button {
        display: inline-flex; align-items: center; gap: 8px;
        font-family: var(--mono); font-size: 12px; font-weight: 600; color: var(--muted);
        background: transparent; border: 1px solid transparent; border-radius: 8px; padding: 7px 12px;
        cursor: pointer; transition: color .15s, background .15s, border-color .15s;
    }
    .it-tabs button:hover { color: var(--text); }
    .it-tabs button.active { color: var(--accent); background: var(--surface2); border-color: var(--border); }
    /* The badge is its own pill with its own gap, and only on the tab that carries data-rec. */
    .it-rec {
        display: none; font-size: 9px; letter-spacing: 0.5px; text-transform: uppercase; line-height: 1;
        color: var(--good); background: var(--good-weak); border: 1px solid var(--good-line);
        border-radius: 999px; padding: 3px 6px;
    }
    .it-tabs button[data-rec] .it-rec { display: inline-flex; }
    .it-row { display: flex; align-items: center; gap: 12px; padding: 16px 18px; }
    /* Scoped under .install-tabs so these win over the docs' global ".doc code" pill styling.
       One line, scrolled: a shell command broken across three lines stops reading as
       something you paste. The scrollbar is hidden because the global themed ones are
       non-overlay and reserved a 10px track under the text - the edge fade below carries
       the affordance instead, and the copy button means nobody has to scroll to use it. */
    .install-tabs .it-text {
        flex: 1; min-width: 0; white-space: pre; overflow-x: auto; scrollbar-width: none;
        font-family: var(--mono); font-size: 13px; line-height: 1.7; color: var(--text); background: transparent; padding: 0;
        /* Fades the right edge so a command running past the box reads as scrollable
           rather than cut. The mask is on the element, so it follows the scroll. */
        -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 34px), transparent);
        mask-image: linear-gradient(90deg, #000 calc(100% - 34px), transparent);
    }
    .install-tabs .it-text::-webkit-scrollbar { display: none; }
    .install-tabs .it-text :global(.t-cmd) { color: var(--accent); }
    .install-tabs .it-text :global(.t-flag) { color: var(--accent2); }
    .install-tabs .it-text :global(.t-url) { color: var(--good); }
    .install-tabs .it-text :global(.t-op) { color: var(--muted); }
    .it-copy { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; color: var(--muted); background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; padding: 8px; cursor: pointer; transition: color .15s, border-color .15s; }
    .it-copy:hover { color: var(--accent); border-color: var(--border-strong); }
    .it-copy.done { color: var(--good); border-color: var(--good); }
    .it-copy svg { width: 15px; height: 15px; display: block; }
    /* Both icons live in the DOM; toggle by class. Injecting the check via innerHTML left an
       SVG that did not paint (the "green box with no check" bug), so swap with CSS instead. */
    .it-copy .ic-check { display: none; }
    .it-copy.done .ic-copy { display: none; }
    .it-copy.done .ic-check { display: block; }
    @media (max-width: 480px) {
        .it-tabs button { padding: 6px 9px; }
        .it-row { padding: 14px; }
    }
</style>

<script>
    import { highlightShell, copyText, INSTALL_METHODS, isWindows, saveInstallMethod } from "../lib/shell";

    // Wire every instance on the page (the component may appear more than once).
    document.querySelectorAll<HTMLElement>(".install-tabs").forEach((root) => {
        const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".it-tabs [role=tab]"));
        const text = root.querySelector<HTMLElement>(".it-text")!;
        const copyBtn = root.querySelector<HTMLButtonElement>(".it-copy")!;
        const next = root.dataset.next || "";

        const commands: Record<string, string> = { ...INSTALL_METHODS };
        const resetCopy = () => { copyBtn.classList.remove("done"); copyBtn.title = "Copy command"; };
        const label = (b: HTMLButtonElement) => b.dataset.cmd + (b.hasAttribute("data-rec") ? ", recommended" : "");

        const select = (b: HTMLButtonElement, focus = false) => {
            for (const t of tabs) {
                const on = t === b;
                t.classList.toggle("active", on);
                t.setAttribute("aria-selected", String(on));
                t.tabIndex = on ? 0 : -1;
            }
            text.innerHTML = highlightShell(commands[b.dataset.cmd!]);
            saveInstallMethod(b.dataset.cmd!); // keep /start in sync with the chosen method
            resetCopy();
            if (focus) b.focus();
        };

        // curl (macOS/Linux) and powershell (Windows) are both always shown; the one matching
        // the visitor's OS is recommended and preselected (curl is the server default).
        if (isWindows()) {
            for (const t of tabs) t.toggleAttribute("data-rec", t.dataset.cmd === "powershell");
        }
        for (const t of tabs) t.setAttribute("aria-label", label(t));
        select(tabs.find((t) => t.hasAttribute("data-rec")) ?? tabs[0]);

        tabs.forEach((b, i) => {
            b.addEventListener("click", () => select(b));
            // Arrow keys move between tabs, as a tablist should.
            b.addEventListener("keydown", (e) => {
                const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
                if (e.key === "Home") { e.preventDefault(); select(tabs[0], true); }
                else if (e.key === "End") { e.preventDefault(); select(tabs[tabs.length - 1], true); }
                else if (step) { e.preventDefault(); select(tabs[(i + step + tabs.length) % tabs.length], true); }
            });
        });

        copyBtn.addEventListener("click", async () => {
            if (!(await copyText(text.textContent || ""))) return;
            copyBtn.classList.add("done"); copyBtn.title = "Copied";
            if (next) setTimeout(() => { window.location.href = next; }, 500);
            else setTimeout(resetCopy, 1800);
        });
    });
</script>
