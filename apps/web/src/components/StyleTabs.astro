---
import Tabs from "./Tabs.astro";

/**
 * The same component in both styling layers.
 *
 * A thin wrapper over Tabs, the way Frameworks is: what it adds is the fixed pair of ids
 * and one persistence key, so a reader who picked CSS once has picked it on every block and
 * every page. Tailwind is first because it is what `enigma add --copy` writes when the
 * project has Tailwind, but the CSS answer is never hidden behind a toggle nobody finds -
 * both tabs are visible from the start.
 *
 * Slots: "tailwind" and "css".
 */
interface Props {
    title?: string;
}
const { title } = Astro.props;

const LAYERS = [
    { id: "tailwind", label: "Tailwind" },
    { id: "css", label: "CSS" }
];

const tabs = LAYERS.filter((layer) => Astro.slots.has(layer.id));
---
<Tabs tabs={tabs} persist="style-layer" note={title} flush={true}>
    {tabs.some((tab) => tab.id === "tailwind") && <div slot="tailwind"><slot name="tailwind" /></div>}
    {tabs.some((tab) => tab.id === "css") && <div slot="css"><slot name="css" /></div>}
</Tabs>
