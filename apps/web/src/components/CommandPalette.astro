---
import type { SearchRecord } from "../lib/search";
import { docHref } from "../lib/url";

interface Props {
    index: SearchRecord[];
}
const { index } = Astro.props;

// Precompute each result's destination href at build, so the client script only needs to
// set location and never touches the base-path logic.
const records = index.map((r) => ({
    title: r.title,
    group: r.group,
    text: r.text,
    href: docHref(r.page, r.id),
}));
---
<div id="cmdk" class="cmdk" hidden role="dialog" aria-modal="true" aria-label="Search the documentation">
    <div class="cmdk-panel">
        <input
            id="cmdk-input"
            class="cmdk-input"
            type="text"
            placeholder="Search the docs..."
            autocomplete="off"
            spellcheck="false"
            aria-label="Search the documentation"
        />
        <div id="cmdk-list" class="cmdk-list" role="listbox"></div>
        <div class="cmdk-foot">
            <span><kbd>&uarr;</kbd><kbd>&darr;</kbd> navigate</span>
            <span><kbd>&crarr;</kbd> open</span>
            <span><kbd>esc</kbd> close</span>
        </div>
    </div>
    <script type="application/json" id="cmdk-data" set:html={JSON.stringify(records)}></script>
</div>

<!-- Styles must be global: the result rows and empty state are injected via innerHTML from
     the client script, so Astro's scoped CSS (which only tags template elements at build)
     would never attach to them. Selectors are cmdk-prefixed and only ship on docs pages. -->
<style is:global>
    .cmdk {
        position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-start; justify-content: center;
        padding: 14vh 16px 16px; background: rgba(4, 6, 10, 0.62); backdrop-filter: blur(7px);
        opacity: 0; transition: opacity .16s ease;
    }
    .cmdk.show { opacity: 1; }
    .cmdk[hidden] { display: none; }
    .cmdk-panel {
        width: 100%; max-width: 560px; background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius); box-shadow: var(--shadow-2); overflow: hidden;
        transform: translateY(-8px) scale(.99); transition: transform .16s ease;
    }
    .cmdk.show .cmdk-panel { transform: none; }
    .cmdk-input {
        display: block; width: 100%; border: 0; border-bottom: 1px solid var(--border-soft); background: transparent;
        color: var(--text); font-family: var(--mono); font-size: 15px; padding: 16px 18px;
    }
    .cmdk-input::placeholder { color: var(--muted); }
    .cmdk-input:focus { outline: none; }
    .cmdk-list { max-height: 54vh; overflow-y: auto; padding: 6px; }

    .cmdk-empty {
        display: flex; flex-direction: column; align-items: center; gap: 10px;
        padding: 36px 18px 38px; color: var(--muted); font-size: 13px; text-align: center;
    }
    .cmdk-empty svg { width: 22px; height: 22px; opacity: .45; flex-shrink: 0; }

    .cmdk-row {
        display: grid; grid-template-columns: 1fr auto; gap: 3px 12px; width: 100%; text-align: left;
        background: transparent; border: 0; border-radius: var(--radius-sm); padding: 10px 12px; cursor: pointer;
        box-shadow: inset 2px 0 0 transparent; transition: background .12s, box-shadow .12s;
    }
    .cmdk-row .t { font-family: var(--mono); font-size: 13.5px; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cmdk-row .g { font-family: var(--mono); font-size: 11px; color: var(--accent); align-self: center; white-space: nowrap; }
    .cmdk-row .s { grid-column: 1 / -1; font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cmdk-row:hover { background: var(--surface2); }
    .cmdk-row.sel { background: var(--surface2); box-shadow: inset 2px 0 0 var(--accent); }

    .cmdk-foot {
        display: flex; gap: 16px; padding: 9px 14px; border-top: 1px solid var(--border-soft);
        color: var(--muted); font-size: 11px; font-family: var(--mono);
    }
    .cmdk-foot kbd { background: var(--surface2); border: 1px solid var(--border); border-radius: 5px; padding: 0 5px; margin-right: 2px; }
</style>

<script>
    import Fuse from "fuse.js";

    interface Rec { title: string; group: string; text: string; href: string; }

    const overlay = document.getElementById("cmdk")!;
    const input = document.getElementById("cmdk-input") as HTMLInputElement;
    const list = document.getElementById("cmdk-list")!;
    const data: Rec[] = JSON.parse(document.getElementById("cmdk-data")?.textContent || "[]");
    const fuse = new Fuse(data, {
        keys: [{ name: "title", weight: 2 }, { name: "text", weight: 1 }, { name: "group", weight: 0.5 }],
        threshold: 0.4, ignoreLocation: true, minMatchCharLength: 2,
    });

    const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]!));
    const SEARCH_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>';
    let results: Rec[] = [];
    let sel = 0;

    function empty(msg: string) {
        results = []; sel = 0;
        list.innerHTML = `<div class="cmdk-empty">${SEARCH_ICON}<span>${esc(msg)}</span></div>`;
    }
    function render(q: string) {
        if (!q) { empty("Type to search the docs..."); return; }
        results = fuse.search(q).slice(0, 8).map((r) => r.item);
        sel = 0;
        if (!results.length) { empty(`No matches for "${q}"`); return; }
        list.innerHTML = results.map((r, i) =>
            `<button type="button" class="cmdk-row${i === 0 ? " sel" : ""}" role="option" data-i="${i}">`
            + `<span class="t">${esc(r.title)}</span><span class="g">${esc(r.group)}</span>`
            + `<span class="s">${esc(r.text)}</span></button>`).join("");
    }
    function move(d: number) {
        if (!results.length) return;
        sel = (sel + d + results.length) % results.length;
        [...list.children].forEach((el, i) => (el as HTMLElement).classList.toggle("sel", i === sel));
        (list.children[sel] as HTMLElement | undefined)?.scrollIntoView({ block: "nearest" });
    }
    function go(r?: Rec) { if (!r) return; close(); location.href = r.href; }
    function open() {
        overlay.hidden = false;
        document.body.style.overflow = "hidden";
        input.value = "";
        empty("Type to search the docs...");
        requestAnimationFrame(() => { overlay.classList.add("show"); input.focus(); });
    }
    function close() {
        overlay.classList.remove("show");
        document.body.style.overflow = "";
        setTimeout(() => { overlay.hidden = true; }, 160);
    }

    input.addEventListener("input", () => render(input.value.trim()));
    overlay.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown") { e.preventDefault(); move(1); }
        else if (e.key === "ArrowUp") { e.preventDefault(); move(-1); }
        else if (e.key === "Enter") { e.preventDefault(); go(results[sel]); }
        else if (e.key === "Escape") { e.preventDefault(); close(); }
    });
    list.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest(".cmdk-row") as HTMLElement | null;
        if (b) go(results[Number(b.dataset.i)]);
    });
    overlay.addEventListener("mousedown", (e) => { if (e.target === overlay) close(); });
    document.querySelectorAll("[data-search-open]").forEach((el) =>
        el.addEventListener("click", (e) => { e.preventDefault(); open(); }));
    document.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); overlay.hidden ? open() : close(); }
    });
</script>
