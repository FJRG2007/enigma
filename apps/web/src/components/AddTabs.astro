---
/**
 * Install picker for a component page: the enigma command, the copy-in variant, and the
 * plain package-manager equivalents. A reader who does not use enigma still needs the
 * one line that works for them, so no tab is hidden behind a tool.
 */
interface Props {
    /** Registry item, e.g. "marquee". Omit for the whole package. */
    item?: string;
    /** Package the item lives in. */
    pkg: string;
}
const { item, pkg } = Astro.props;

const commands: Record<string, string> = {
    enigma: item ? `enigma add ${item}` : "enigma add --all",
    copy: item ? `enigma add ${item} --copy` : "enigma add --all --copy",
    npm: `npm install ${pkg}`,
    pnpm: `pnpm add ${pkg}`,
    yarn: `yarn add ${pkg}`,
    bun: `bun add ${pkg}`
};
const names = Object.keys(commands);
---
<div class="at" data-add-tabs data-commands={JSON.stringify(commands)}>
    <div class="at-tabs" role="tablist">
        {names.map((name, index) => (
            <button type="button" role="tab" class={index === 0 ? "active" : ""} data-at-tab={name} aria-selected={index === 0 ? "true" : "false"}>{name}</button>
        ))}
    </div>
    <div class="at-body">
        <code class="at-text" data-at-text>{commands.enigma}</code>
        <button type="button" class="at-copy" data-at-copy aria-label="Copy command" title="Copy">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        </button>
    </div>
</div>

<style>
    .at { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; margin: 16px 0; }
    .at-tabs { display: flex; flex-wrap: wrap; gap: 2px; padding: 7px; background: rgba(0, 0, 0, 0.25); border-bottom: 1px solid var(--border-soft); }
    .at-tabs button { font-family: var(--mono); font-size: 12px; font-weight: 600; color: var(--muted); background: transparent; border: 1px solid transparent; border-radius: 8px; padding: 6px 12px; cursor: pointer; }
    .at-tabs button:hover { color: var(--text); }
    .at-tabs button.active { color: var(--accent); background: var(--surface2); border-color: var(--border); }
    .at-body { display: flex; align-items: center; gap: 10px; padding: 13px 14px; }
    /* One line, scrolled rather than wrapped: a shell command broken across three lines
       stops reading as something you can paste. */
    .at .at-text {
        flex: 1; min-width: 0; white-space: pre; overflow-x: auto; scrollbar-width: none;
        font-family: var(--mono); font-size: 13px; color: var(--text); background: transparent; padding: 0;
    }
    .at .at-text::-webkit-scrollbar { display: none; }
    .at-copy { flex: 0 0 auto; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; color: var(--muted); background: transparent; border: 1px solid var(--border); cursor: pointer; }
    .at-copy:hover { color: var(--text); border-color: var(--accent); }
    .at-copy svg { width: 14px; height: 14px; }
</style>

<script>
    for (const block of document.querySelectorAll<HTMLElement>("[data-add-tabs]")) {
        const commands = JSON.parse(block.dataset.commands ?? "{}") as Record<string, string>;
        const text = block.querySelector<HTMLElement>("[data-at-text]")!;
        const tabs = block.querySelectorAll<HTMLButtonElement>("[data-at-tab]");

        for (const tab of tabs) {
            tab.addEventListener("click", () => {
                for (const other of tabs) {
                    const on = other === tab;
                    other.classList.toggle("active", on);
                    other.setAttribute("aria-selected", String(on));
                }
                text.textContent = commands[tab.dataset.atTab ?? ""] ?? "";
            });
        }

        block.querySelector<HTMLButtonElement>("[data-at-copy]")!.addEventListener("click", async (event) => {
            const button = event.currentTarget as HTMLButtonElement;
            const value = text.textContent ?? "";
            try {
                await navigator.clipboard.writeText(value);
            } catch {
                // A clipboard-guard extension can break writeText; execCommand still works.
                const scratch = document.createElement("textarea");
                scratch.value = value;
                document.body.append(scratch);
                scratch.select();
                document.execCommand("copy");
                scratch.remove();
            }
            button.classList.add("ok");
            setTimeout(() => button.classList.remove("ok"), 1200);
        });
    }
</script>
