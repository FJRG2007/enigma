---
import Tabs from "./Tabs.astro";

/**
 * A component-documentation block: the thing running, and the code that runs it.
 *
 * The preview is a REAL instance driven by the package, not a picture or a recording - a
 * marquee whose whole contract is timing and pointer behaviour cannot be documented by a
 * screenshot, and a demo that drifts from the package is worse than none.
 *
 * A thin wrapper over Tabs, like StyleTabs and Frameworks. It had its own tab strip and its
 * own script once, which made four implementations of one widget on this site, each with
 * its own attribute names and its own keyboard behaviour. This one keeps its frame, because
 * unlike a chooser a demo IS a block of content.
 *
 * Slots: default = the live preview, "code" = the source (a fenced block from the MDX).
 */
interface Props {
    /** Short label above the block, e.g. the variant being shown. */
    title?: string;
    /** Hint under the preview, e.g. "drag it". */
    hint?: string;
}
const { title, hint } = Astro.props;
---
<div class="pv">
    <Tabs tabs={[{ id: "preview", label: "Preview" }, { id: "code", label: "Code" }]} note={title} frame={true} flush={true}>
        <div slot="preview">
            <div class="pv-stage"><slot /></div>
            {hint && <p class="pv-hint">{hint}</p>}
        </div>
        <div slot="code"><slot name="code" /></div>
    </Tabs>
</div>

<style>
    .pv-stage { padding: 28px 20px; display: grid; gap: 14px; }
    .pv-hint { margin: 0; padding: 0 20px 16px; font-size: 12px; color: var(--muted); }
</style>
