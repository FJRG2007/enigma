---
import { asset } from "../../lib/url";

/**
 * A "trusted by" logo wall on the marquee: what the primitive is most often used for.
 *
 * Every entry is a MARK plus its name. Real brand assets are icon-only and come in wildly
 * different aspect ratios - 100x100, 24x24, 240x300 - so dropping them next to wordmarks
 * makes the icons read as broken specks. A fixed box with `object-fit: contain` plus the
 * name as text is what makes a mixed set look like one row.
 *
 * The tint is a CSS technique, NOT a feature of @enigmax/primitives - the primitive ships
 * no styles and this belongs to the theme. It is documented here because every logo wall
 * needs it and every logo wall gets it wrong: a `filter` chain cannot hit an exact colour,
 * so the mark is used as a MASK and the colour is painted behind it. That works for any
 * transparent asset - SVG, PNG or WebP alike.
 *
 * Untinted is the default on purpose: a brand's own colours are the correct rendering, and
 * a monochrome wall is a deliberate design choice rather than the baseline.
 */
interface Props {
    /** Paint every mark this colour. Omit to keep the brands' own colours. */
    tint?: string;
    speed?: number;
    hover?: string;
}
const { tint, speed = 55, hover = "off" } = Astro.props;

// Four real, already-vendored brand marks plus four obvious placeholders, so the row is
// long enough to loop without inventing logos for companies that never agreed to appear.
const logos = [
    { name: "Claude Code", src: asset("logos/claude.svg") },
    { name: "Codex", src: asset("logos/openai.svg") },
    { name: "opencode", src: asset("logos/opencode.svg") },
    { name: "Kimi Code", src: asset("logos/kimi.svg") },
    { name: "Northwind", src: asset("demo-logos/northwind.svg") },
    { name: "Vellum", src: asset("demo-logos/vellum.svg") },
    { name: "Acme Grid", src: asset("demo-logos/acme-grid.svg") },
    { name: "Plinth", src: asset("demo-logos/plinth.svg") }
];
---
<div
    class:list={["lw", tint && "is-tinted"]}
    style={tint ? `--logo-color: ${tint}` : undefined}
    data-marquee
    data-speed={String(speed)}
    data-hover={hover}
>
    <div class="lw-track" data-marquee-track>
        <div class="lw-copy">
            {logos.map((logo) => (
                <span class="lw-item">
                    {tint
                        ? <span class="lw-mark is-masked" style={`--logo-src: url("${logo.src}")`} aria-hidden="true"></span>
                        : <img class="lw-mark" src={logo.src} alt="" draggable={false} />}
                    <span class="lw-name">{logo.name}</span>
                </span>
            ))}
        </div>
    </div>
</div>

<style>
    .lw { position: relative; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent); mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent); }
    .lw-track { display: flex; }
    .lw-copy { display: flex; align-items: center; gap: 38px; padding-right: 38px; }
    .lw-item { display: inline-flex; align-items: center; gap: 9px; white-space: nowrap; opacity: .72; transition: opacity .2s; }
    .lw:hover .lw-item { opacity: 1; }

    /* One box for every mark, whatever aspect the brand's own file happens to be. */
    .lw-mark { flex: 0 0 auto; width: 22px; height: 22px; object-fit: contain; }
    .lw-name { font-size: 13px; color: var(--text); }

    /* The tint. The asset becomes the mask and the colour is the paint, so a flat
       PNG/WebP/SVG with transparency lands on an exact colour instead of whatever a
       filter chain approximates. The name follows it, or the row reads half-tinted. */
    .lw-mark.is-masked {
        display: block;
        background-color: var(--logo-color, currentColor);
        -webkit-mask-image: var(--logo-src); mask-image: var(--logo-src);
        -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
        -webkit-mask-position: center; mask-position: center;
        -webkit-mask-size: contain; mask-size: contain;
    }
    .lw.is-tinted .lw-name { color: var(--logo-color); }
</style>

<script>
    import { createMarquee } from "@enigmax/primitives";

    for (const lane of document.querySelectorAll<HTMLElement>("[data-marquee]")) {
        // Two demo components can be on one page and each ships this loop; the flag
        // keeps a lane from being driven by two engines fighting over one transform.
        if (lane.dataset.marqueeReady) continue;
        lane.dataset.marqueeReady = "1";
        const track = lane.querySelector<HTMLElement>("[data-marquee-track]");
        if (!track) continue;
        // A data attribute is always a string; "off"/"pause" stay as they are and
        // anything else is a multiplier, or the engine would read NaN.
        const raw = lane.dataset.hover ?? "off";
        const hover = raw === "off" || raw === "pause" ? raw : Number(raw);
        createMarquee(lane, track, {
            speed: Number(lane.dataset.speed ?? 70),
            hover,
            reverse: lane.dataset.reverse === "true"
        });
    }
</script>
