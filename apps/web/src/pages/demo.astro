---
import Base from "../layouts/Base.astro";
import { url, docHref } from "../lib/url";

const title = "Dashboard demo - Enigma";
const description = "A static, mock-data preview of the Enigma control panel. Nothing here is live - install enigma and run `enigma dash` for the real thing.";

// Static mock figures, kept internally consistent (Before - After = Removed, etc.) so the
// demo reads like a real session without wiring any data. Nothing on this page is live.
const sources = [
    { name: "Claude Code", pct: 100, tokens: "8.6M", money: "$31.10" },
    { name: "OpenCode", pct: 36, tokens: "3.1M", money: "$11.40" },
    { name: "Codex", pct: 14, tokens: "1.2M", money: "$4.20" },
    { name: "CLI", pct: 6, tokens: "0.5M", money: "$1.50" },
];
const types = [
    { name: "json", pct: 100, tokens: "6.2M" },
    { name: "log", pct: 61, tokens: "3.8M" },
    { name: "text", pct: 31, tokens: "1.9M" },
    { name: "diff", pct: 15, tokens: "0.9M" },
    { name: "code", pct: 6, tokens: "0.4M" },
    { name: "markdown", pct: 3, tokens: "0.2M" },
];
const recent = [
    { t: "2m ago", type: "json", src: "Claude Code", ba: "48.2K -> 19.1K", saved: "60%" },
    { t: "11m ago", type: "log", src: "OpenCode", ba: "12.4K -> 3.1K", saved: "75%" },
    { t: "26m ago", type: "diff", src: "Codex", ba: "8.0K -> 5.2K", saved: "35%" },
    { t: "40m ago", type: "text", src: "Claude Code", ba: "22.7K -> 14.8K", saved: "35%" },
    { t: "1h ago", type: "json", src: "CLI", ba: "96.3K -> 38.5K", saved: "60%" },
];
const systems = [
    { name: "Context compression", state: "on", tag: "measured" },
    { name: "Real tool-usage stats", state: "off" },
    { name: "Permission bypass", state: "on" },
    { name: "Commit secret guard", state: "on" },
    { name: "Prompt secret guard", state: "off" },
    { name: "Measuring proxy", state: "off" },
];
---
<Base title={title} description={description} ogImage="https://raw.githubusercontent.com/FJRG2007/enigma/main/assets/images/dashboard.png">
    <div class="dash">
        <div class="demobar">
            <span class="db-tag">Static demo</span>
            <span class="db-txt">Mock data - nothing here is live. Install enigma and run <code>enigma dash</code> for the real, interactive control panel.</span>
            <span class="db-act">
                <a href={url("")} class="db-btn">&larr; Back to site</a>
                <a href={url("") + "#install"} class="db-btn primary">Install Enigma</a>
            </span>
        </div>

        <header>
            <div class="brand">
                <div class="wordmark">Enigma<span aria-hidden="true">.</span></div>
                <div class="sub">Control panel</div>
            </div>
            <nav class="tabs" aria-label="Demo views (not interactive)">
                <span class="tab active">Savings</span>
                <span class="tab">Usage</span>
                <span class="tab">Accounts</span>
                <span class="tab">Skills</span>
                <span class="tab">Settings</span>
                <span class="tab">Resources</span>
            </nav>
            <div class="nav">
                <span class="live"><span class="dot"></span>Mock data</span>
                <nav class="links">
                    <a href="https://github.com/FJRG2007/enigma" target="_blank" rel="noopener noreferrer" title="GitHub" aria-label="GitHub">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.52 11.52 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
                    </a>
                    <a href="https://tpe.li/dsc" target="_blank" rel="noopener noreferrer" title="Discord" aria-label="Discord">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286ZM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189Zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9461 2.4189-2.1568 2.4189Z"></path></svg>
                    </a>
                </nav>
            </div>
        </header>

        <main>
            <div class="grid">
                <div class="card hero"><div class="label">Money Saved</div><div class="value good">$48.20</div><div class="foot">Estimated, by source</div></div>
                <div class="card"><div class="label">Time Saved</div><div class="value accent">1h 12m</div><div class="foot">Estimated prefill time</div></div>
                <div class="card"><div class="label">Tokens Saved</div><div class="value">13.4M</div><div class="foot">Across all compressions</div></div>
                <div class="card"><div class="label">Savings Rate</div><div class="value accent">41%</div><div class="foot">Of input tokens removed</div></div>
                <div class="card"><div class="label">Compressions</div><div class="value">1,284</div><div class="foot">Reversible via CCR</div></div>
                <div class="card"><div class="label">Avg / Compression</div><div class="value">10.4K</div><div class="foot">Tokens saved per call</div></div>
                <div class="card"><div class="label">Best Compression</div><div class="value">214K</div><div class="foot">Most saved in one call</div></div>
            </div>

            <div class="panel">
                <div class="panel-head"><h2>Enigma Systems <small>what's active - configuration, not savings</small></h2></div>
                <div class="sys-grid">
                    {systems.map((s) => (
                        <div class="sys">
                            <span class="sys-name">{s.name}</span>
                            <span class={`sys-tag ${s.tag === "measured" ? "meas" : s.state}`}>{s.tag === "measured" ? "measured" : s.state}</span>
                        </div>
                    ))}
                </div>
                <div class="sub" style="margin-top:14px">Skills deployed to Claude Code, Codex and opencode - sealed and auto-synced.</div>
            </div>

            <div class="panel">
                <div class="panel-head">
                    <h2>Savings Per Day <small>last 30 days</small></h2>
                    <div class="ctrls">
                        <div class="ranges"><button type="button" class="active">Tokens</button><button type="button">$</button></div>
                        <div class="ranges"><button type="button" class="active">Daily</button><button type="button">Cumulative</button></div>
                        <div class="ranges"><button type="button">7D</button><button type="button" class="active">30D</button><button type="button">90D</button><button type="button">All</button></div>
                    </div>
                </div>
                <div class="chartwrap">
                    <svg viewBox="0 0 820 240" preserveAspectRatio="none" role="img" aria-label="Mock tokens-saved-per-day area chart">
                        <defs>
                            <linearGradient id="area" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.32"></stop>
                                <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"></stop>
                            </linearGradient>
                        </defs>
                        <line x1="0" y1="220" x2="820" y2="220" stroke="var(--border)" stroke-width="1"></line>
                        <path d="M0,180 L53,165 107,172 160,150 213,158 267,132 320,140 373,118 427,126 480,98 533,110 587,82 640,92 693,66 747,74 800,52 L820,52 L820,240 L0,240 Z" fill="url(#area)"></path>
                        <path d="M0,180 L53,165 107,172 160,150 213,158 267,132 320,140 373,118 427,126 480,98 533,110 587,82 640,92 693,66 747,74 800,52" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"></path>
                    </svg>
                </div>
            </div>

            <div class="panel">
                <h2 style="margin-bottom:14px">Savings By Source <small>which app/CLI compressed</small></h2>
                {sources.map((s) => (
                    <div class="bar-row">
                        <span class="name">{s.name}</span>
                        <div class="bar-track"><div class="bar-fill" style={`width:${s.pct}%;background:var(--accent)`}></div></div>
                        <span class="num">{s.tokens}</span>
                        <span class="money">{s.money}</span>
                    </div>
                ))}
            </div>

            <div class="panel">
                <h2 style="margin-bottom:14px">Savings By Content Type <small>what enigma compressed</small></h2>
                {types.map((t) => (
                    <div class="bar-row">
                        <span class="name">{t.name}</span>
                        <div class="bar-track"><div class="bar-fill" style={`width:${t.pct}%;background:var(--good)`}></div></div>
                        <span class="num">{t.tokens}</span>
                    </div>
                ))}
            </div>

            <div class="panel">
                <h2 style="margin-bottom:14px">Before vs. After <small>cumulative tokens</small></h2>
                <div class="bar-row"><span class="name">Before</span><div class="bar-track"><div class="bar-fill" style="width:100%;background:var(--accent2)"></div></div><span class="num">32.7M</span></div>
                <div class="bar-row"><span class="name">After</span><div class="bar-track"><div class="bar-fill" style="width:59%;background:var(--good)"></div></div><span class="num">19.3M</span></div>
                <div class="stat-line" style="margin:14px 0 0"><div>Removed <b>13.4M</b></div><div>Reduction <b>59%</b></div><div>Compression ratio <b>1.7:1</b></div></div>
            </div>

            <div class="panel">
                <h2 style="margin-bottom:14px">Recent Compressions <small>newest first</small></h2>
                <div class="tbl-wrap">
                    <table class="tbl">
                        <thead><tr><th>When</th><th>Type</th><th>Source</th><th>Before -&gt; After</th><th class="r">Saved</th></tr></thead>
                        <tbody>
                            {recent.map((r) => (
                                <tr><td>{r.t}</td><td>{r.type}</td><td>{r.src}</td><td>{r.ba}</td><td class="r good">{r.saved}</td></tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>

            <footer class="dfoot">
                Static demo with mock data. The real dashboard is local, loopback-only and shows your own usage. Run <code>enigma dash</code> after installing - or do the same from <a href={docHref("commands")}>the CLI</a>.
            </footer>
        </main>
    </div>
</Base>

<style is:global>
    body {
        background:
            radial-gradient(1100px 620px at 82% -10%, rgba(224, 164, 88, 0.10), transparent 58%),
            radial-gradient(820px 520px at 2% 2%, rgba(111, 207, 151, 0.045), transparent 52%),
            var(--bg);
        background-attachment: fixed;
    }
</style>

<style>
    .dash {
        --warn: #e3c14e; --bad: #e0564f; --good-weak: rgba(111, 207, 151, 0.12);
        --elev: linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0) 42%);
        max-width: 1560px; margin: 0 auto; padding: 18px 30px 48px;
    }

    .demobar {
        display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
        background: linear-gradient(135deg, var(--accent-weak), transparent 70%), var(--surface);
        border: 1px solid rgba(224, 164, 88, 0.35); border-radius: var(--radius);
        padding: 12px 16px; margin-bottom: 24px; box-shadow: var(--shadow-1);
    }
    .db-tag { font-family: var(--mono); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.6px; color: #1a1206; background: var(--accent); border-radius: 999px; padding: 3px 10px; }
    .db-txt { color: var(--muted); font-size: 13px; flex: 1; min-width: 220px; }
    .db-txt code, .dfoot code, .dash code { font-family: var(--mono); font-size: 12px; color: var(--accent2); background: var(--surface2); padding: 1px 6px; border-radius: 5px; }
    .db-act { display: flex; gap: 8px; flex-wrap: wrap; }
    .db-btn { font-family: var(--mono); font-size: 12px; color: var(--text); background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; padding: 7px 13px; }
    .db-btn:hover { color: var(--text); border-color: #2f3744; }
    .db-btn.primary { color: #1a1206; background: var(--accent); border-color: var(--accent); font-weight: 600; }
    .db-btn.primary:hover { color: #1a1206; background: #e8b06a; }

    .dash header { display: flex; align-items: center; gap: 22px; margin-bottom: 26px; flex-wrap: wrap; }
    .brand { display: flex; flex-direction: column; gap: 3px; }
    .wordmark { font-family: var(--mono); font-size: 20px; font-weight: 600; letter-spacing: 0.5px; display: inline-flex; align-items: center; color: var(--text); }
    .wordmark span { display: inline-block; width: 0.46em; height: 1.05em; margin-left: 5px; background: var(--accent); transform: translateY(1px); text-indent: -9999px; overflow: hidden; animation: caret 1.1s steps(1, end) infinite; }
    @keyframes caret { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }
    .sub { font-family: var(--mono); color: var(--muted); font-size: 10.5px; text-transform: uppercase; letter-spacing: 1.6px; }

    .tabs { display: flex; gap: 2px; padding: 4px; background: rgba(0, 0, 0, 0.25); border: 1px solid var(--border-soft); border-radius: 13px; }
    .tabs .tab { font-family: var(--mono); color: var(--muted); font-size: 12px; font-weight: 600; padding: 7px 15px; border-radius: 9px; border: 1px solid transparent; }
    .tabs .tab.active { color: var(--accent); background: var(--surface2); border-color: var(--border); box-shadow: var(--shadow-1); }

    .nav { margin-left: auto; display: flex; align-items: center; gap: 18px; }
    .live { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 12px; font-family: var(--mono); padding: 5px 12px; background: rgba(0, 0, 0, 0.25); border: 1px solid var(--border-soft); border-radius: 999px; }
    .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--good); box-shadow: 0 0 8px var(--good); }
    .links { display: flex; gap: 14px; align-items: center; }
    .links a { color: var(--muted); display: inline-flex; }
    .links a:hover { color: var(--accent); }
    .links svg { width: 19px; height: 19px; display: block; }

    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(166px, 1fr)); gap: 14px; margin-bottom: 22px; }
    .card { position: relative; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; box-shadow: var(--shadow-1); overflow: hidden; }
    .card::before { content: ""; position: absolute; inset: 0; background: var(--elev); pointer-events: none; }
    .card.hero { grid-column: span 2; border-color: rgba(224, 164, 88, 0.35); background: linear-gradient(135deg, var(--accent-weak), transparent 62%), var(--surface); }
    .card.hero .value { font-size: 42px; }
    .card .label { position: relative; font-family: var(--mono); color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.7px; }
    .card .value { position: relative; font-family: var(--mono); font-size: 30px; font-weight: 600; margin-top: 10px; font-variant-numeric: tabular-nums; letter-spacing: -0.6px; }
    .card .value.accent { color: var(--accent); }
    .card .value.good { color: var(--good); }
    .card .foot { position: relative; color: var(--muted); font-size: 12px; margin-top: 5px; }

    .panel { position: relative; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px 22px; margin-bottom: 18px; box-shadow: var(--shadow-1); }
    .panel-head { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
    .panel h2 { display: flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.9px; margin: 0; color: var(--text); }
    .panel h2::before { content: ""; flex: 0 0 auto; width: 3px; height: 13px; border-radius: 2px; background: var(--accent); }
    .panel h2 small { font-family: var(--sans); color: var(--muted); font-weight: 400; font-size: 12px; text-transform: none; letter-spacing: 0; }
    .ctrls { margin-left: auto; display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
    .ranges { display: flex; gap: 2px; padding: 3px; background: rgba(0, 0, 0, 0.22); border: 1px solid var(--border-soft); border-radius: 9px; }
    .ranges button { background: transparent; color: var(--muted); border: 1px solid transparent; border-radius: 6px; padding: 4px 11px; font-size: 12px; cursor: default; font-family: var(--mono); }
    .ranges button.active { background: var(--accent); color: #1a1206; border-color: var(--accent); font-weight: 600; }

    .chartwrap { position: relative; width: 100%; height: 280px; }
    .chartwrap svg { width: 100%; height: 100%; display: block; }

    .sys-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
    .sys { display: flex; align-items: center; justify-content: space-between; gap: 10px; background: var(--surface2); border: 1px solid var(--border-soft); border-radius: var(--radius-sm); padding: 11px 14px; }
    .sys-name { font-size: 13px; color: var(--text); }
    .sys-tag { font-family: var(--mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.5px; border: 1px solid var(--border); border-radius: 6px; padding: 2px 8px; color: var(--muted); }
    .sys-tag.on { color: var(--good); border-color: var(--good); background: var(--good-weak); }
    .sys-tag.off { color: var(--muted); }
    .sys-tag.meas { color: var(--good); border-color: var(--good); background: var(--good-weak); font-weight: 600; }

    .bar-row { display: flex; align-items: center; gap: 12px; margin: 11px 0; font-size: 13px; }
    .bar-row .name { width: 90px; color: var(--muted); }
    .bar-track { flex: 1; height: 12px; background: rgba(0, 0, 0, 0.32); border: 1px solid var(--border-soft); border-radius: 999px; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 999px; }
    .bar-row .num { width: 70px; text-align: right; font-family: var(--mono); font-variant-numeric: tabular-nums; }
    .bar-row .money { width: 72px; text-align: right; color: var(--good); font-family: var(--mono); font-variant-numeric: tabular-nums; }
    .stat-line { display: flex; gap: 24px; flex-wrap: wrap; }
    .stat-line div { font-size: 13px; color: var(--muted); }
    .stat-line b { color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums; }

    .tbl-wrap { border: 1px solid var(--border-soft); border-radius: var(--radius-sm); overflow: hidden; }
    .tbl { width: 100%; border-collapse: collapse; font-size: 13px; }
    .tbl th { text-align: left; background: var(--surface); color: var(--muted); font-family: var(--mono); font-weight: 600; font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.6px; padding: 8px 12px; border-bottom: 1px solid var(--border); }
    .tbl td { padding: 8px 12px; border-bottom: 1px solid var(--border-soft); font-variant-numeric: tabular-nums; }
    .tbl tr:last-child td { border-bottom: none; }
    .tbl .r { text-align: right; }
    .tbl .good { color: var(--good); }

    .dfoot { color: var(--muted); font-size: 12px; line-height: 1.6; margin-top: 8px; }

    @media (max-width: 720px) { .dash { padding: 14px 16px 40px; } .card.hero { grid-column: span 1; } .tabs { order: 3; width: 100%; overflow-x: auto; } }
</style>
