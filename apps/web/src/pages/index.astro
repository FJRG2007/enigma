    .skill-f { font-family: var(--mono); font-size: 11px; color: var(--muted); margin-top: 12px; }
    .muted { color: var(--muted); }
    h1 { font-family: var(--mono); font-size: clamp(34px, 6vw, 58px); line-height: 1.05; font-weight: 600; letter-spacing: -1px; margin: 16px auto 0; max-width: 14ch; }
    .lede { color: var(--muted); font-size: clamp(16px, 2.4vw, 20px); max-width: 56ch; margin: 18px auto 0; }

    /* The install picker itself lives in InstallTabs.astro; the hero only centers it. */
    .install-wrap { max-width: 620px; margin: 36px auto 0; }

    .works { margin: 30px auto 0; display: flex; align-items: center; justify-content: center; gap: 22px; flex-wrap: wrap; color: var(--muted); font-family: var(--mono); font-size: 12px; }
    .works img { width: 26px; height: 26px; opacity: .9; }
    .works .row { display: flex; align-items: center; gap: 16px; }

    section { padding: 64px 0; }
    .s-head { text-align: center; max-width: 60ch; margin: 0 auto 36px; }
    .s-head .eyebrow { display: block; }
    h2 { font-family: var(--mono); font-size: clamp(24px, 4vw, 34px); font-weight: 600; letter-spacing: -0.5px; margin: 10px 0 0; }
    .s-head p { color: var(--muted); margin: 12px auto 0; }

    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 16px; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; box-shadow: var(--shadow-1); transition: border-color .18s, transform .18s; }
    .card:hover { border-color: #2f3744; transform: translateY(-2px); }
    .card h3 { font-family: var(--mono); font-size: 15px; font-weight: 600; margin: 0; display: flex; align-items: center; gap: 9px; }
    .card h3::before { content: ""; width: 3px; height: 14px; border-radius: 2px; background: var(--accent); }
    .card p { color: var(--muted); font-size: 14px; margin: 10px 0 0; }
    .card code { font-family: var(--mono); font-size: 12px; color: var(--accent2); background: var(--surface2); padding: 1px 6px; border-radius: 5px; }

    /* Before/after comparison: a faint dot-grid backdrop fades in behind the cards. */
    #difference { position: relative; }
    #difference::before { content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
        background-image: radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.045) 1px, transparent 0); background-size: 22px 22px;
        -webkit-mask: radial-gradient(62% 56% at 50% 42%, #000, transparent 75%); mask: radial-gradient(62% 56% at 50% 42%, #000, transparent 75%); }
    #difference .wrap { position: relative; z-index: 1; }

    /* Comparison content (the window chrome lives in Compare.astro). */
    .cmp-list { max-width: 900px; margin: 0 auto; }
    .cmp-code { margin: 0; font-family: var(--mono); font-size: 12px; line-height: 1.75; color: var(--text); white-space: pre; overflow-x: auto; }
    .cmp-win.bad .cmp-code { color: #b9aaa4; }
    .cmp-code .kw { color: var(--accent); }
    .cmp-code .str { color: var(--good); }
    .cmp-code .dim { color: #5d6675; }
    .cmp-code .k { color: var(--good); user-select: none; }
    .cmp-code .g { color: var(--good); }
    .cmp-code .r { color: #e0564f; }
    .cmp-prose { margin: 0; font-size: 13.5px; line-height: 1.62; }
    .cmp-win.bad .cmp-prose { color: var(--muted); }
    .cmp-win.good .cmp-prose { color: var(--text); }
    .cmp-lines { display: inline-block; font-family: var(--mono); font-size: 10px; letter-spacing: 0.3px; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 1px 9px; margin-bottom: 10px; }

    .shot { margin: 8px auto 0; max-width: var(--max); }
    .shot img { width: 100%; border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-2); display: block; }

    .compare { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-1); }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th, td { text-align: left; padding: 13px 18px; border-bottom: 1px solid var(--border-soft); }
    th { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.6px; color: var(--muted); }
    thead th:nth-child(2) { color: var(--accent); }
    tbody tr:last-child td { border-bottom: none; }
    td:first-child { color: var(--muted); }
    .yes { color: var(--good); } .no { color: var(--accent2); }

    .bottom { text-align: center; }
    .bottom h2 { margin-bottom: 8px; }
    .btn { display: inline-block; font-family: var(--mono); font-size: 14px; font-weight: 600; color: #1a1206; background: var(--accent); padding: 12px 24px; border-radius: 11px; margin-top: 22px; }
    .btn.ghost { color: var(--text); background: var(--surface2); border: 1px solid var(--border); margin-left: 10px; }
    .btn:hover { color: #1a1206; background: #e8b06a; }
    .btn.ghost:hover { color: var(--text); background: var(--surface); border-color: #2f3744; }

    .hero-cta { margin: 26px 0 0; }
    .hero-cta .btn { display: inline-flex; align-items: center; gap: 9px; margin-top: 0; }
    .hero-cta .btn svg { width: 16px; height: 16px; }
    .dash-cta { text-align: center; margin-top: 22px; }

    .ghb { display: inline-flex; align-items: center; font-family: var(--mono); font-size: 12px; }
    .ghb a { color: var(--text) !important; }
    .ghb-btn { display: inline-flex; align-items: center; gap: 6px; background: var(--surface2); border: 1px solid var(--border); border-radius: 8px 0 0 8px; padding: 6px 11px; font-weight: 600; }
    .ghb-btn svg { width: 14px; height: 14px; flex: 0 0 auto; }
    .ghb-btn:hover { color: var(--accent) !important; background: #20262f; }
    .ghb-count { position: relative; background: var(--surface); border: 1px solid var(--border); border-left: none; border-radius: 0 8px 8px 0; padding: 6px 11px 6px 12px; font-variant-numeric: tabular-nums; }
    .ghb-count::before { content: ""; position: absolute; left: -4.5px; top: 50%; transform: translateY(-50%) rotate(45deg); width: 8px; height: 8px; background: var(--surface); border-left: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .ghb-count:hover { color: var(--accent) !important; }

    footer .links a { color: var(--muted); display: inline-flex; }
    footer .links a:hover { color: var(--accent); }
    footer .links svg { width: 18px; height: 18px; display: block; }
    footer { border-top: 1px solid var(--border-soft); padding: 30px 0; color: var(--muted); font-size: 13px; }
    footer .wrap { display: flex; gap: 16px 24px; align-items: center; flex-wrap: wrap; }
    footer .foot-links { display: flex; gap: 18px; flex-wrap: wrap; font-family: var(--mono); font-size: 13px; }
    footer .foot-links a { color: var(--muted); }
    footer .foot-links a:hover { color: var(--text); }
    footer .links { margin-left: auto; display: flex; gap: 18px; }

    @media (max-width: 640px) { nav .links a.hide-sm { display: none; } header.hero { padding: 56px 0 28px; } }
</style>

<script>
    // The install picker (tabs + copy + navigate-to-/start) lives in InstallTabs.astro; this
    // page only wires the skills catalog and the live star count.

    // Skills marketplace: the official catalog is generated by `enigma seal` into
    // docs/skills-catalog.json (single source of truth) and read here over GitHub raw
    // (CORS-open, no auth). Fault-tolerant: any failure leaves a friendly message.
    (function () {
        const grid = document.getElementById("skillsGrid");
        if (!grid) return;
        const CATALOG = "https://raw.githubusercontent.com/FJRG2007/enigma/main/docs/skills-catalog.json";
        const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]!));
        const ago = (iso: string) => {
            if (!iso) return "";
            const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86400000);
            if (days <= 0) return "today";
            if (days === 1) return "yesterday";
            if (days < 30) return days + " days ago";
            if (days < 365) return Math.floor(days / 30) + " month" + (days < 60 ? "" : "s") + " ago";
            return Math.floor(days / 365) + " year" + (days < 730 ? "" : "s") + " ago";
        };
        fetch(CATALOG, { cache: "no-store" })
            .then((r) => r.json())
            .then((c) => {
                const skills = (c.skills || []).slice().sort((a: any, b: any) => +new Date(b.updated || 0) - +new Date(a.updated || 0));
                if (!skills.length) { grid.innerHTML = '<p class="muted">No skills found.</p>'; return; }
                grid.innerHTML = skills.map((s: any) => '<div class="card">'
                    + '<div class="skill-h"><h3>' + esc(s.name) + "</h3>"
                    + (s.version ? '<span class="vtag">v' + esc(s.version) + "</span>" : "") + "</div>"
                    + "<p>" + esc(s.description || "") + "</p>"
                    + (s.updated ? '<div class="skill-f" title="' + esc(new Date(s.updated).toLocaleString()) + '">Edited ' + esc(ago(s.updated)) + "</div>" : "")
                    + "</div>").join("");
            })
            .catch(() => { grid.innerHTML = '<p class="muted">Could not load the skills catalog. Try again later.</p>'; });
    })();

    // Live GitHub star count (unauthenticated, CORS-open; rate-limited per IP).
    fetch("https://api.github.com/repos/FJRG2007/enigma")
        .then((r) => r.json())
        .then((d) => {
            const n = Number(d.stargazers_count);
            if (!Number.isFinite(n)) return;
            document.getElementById("stars")!.textContent = n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, "") + "k" : String(n);
        })
        .catch(() => { /* keep the placeholder */ });
</script>
