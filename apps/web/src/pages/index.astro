    .s-cta { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-8); justify-content: center; }
    .muted { color: var(--muted); }

    .fgroup + .fgroup { margin-top: var(--s-10); }
    .fgroup-h { font-family: var(--mono); font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 1.4px; color: var(--muted); margin: 0 0 var(--s-4); display: flex; align-items: center; gap: var(--s-3); }
    .fgroup-h::after { content: ""; flex: 1; height: 1px; background: var(--border-soft); }

    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: var(--s-4); }
    .card {
        display: flex; flex-direction: column; min-width: 0;
        background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
        padding: var(--s-6); box-shadow: var(--shadow-1); transition: border-color .18s, transform .18s, box-shadow .18s;
    }
    .card:hover { border-color: var(--border-strong); transform: translateY(-2px); box-shadow: var(--shadow-2); }
    .card h3, .card h4 { font-family: var(--sans); font-size: var(--fs-h3); font-weight: 650; letter-spacing: -0.01em; margin: 0; display: flex; align-items: center; gap: 9px; min-width: 0; }
    .card h3::before, .card h4::before { content: ""; width: 3px; height: 14px; border-radius: 2px; background: var(--accent); flex: 0 0 auto; }
    .card p { color: var(--muted); font-size: 14px; line-height: 1.6; margin: var(--s-2) 0 0; overflow-wrap: anywhere; }
    .card code { font-family: var(--mono); font-size: 12px; color: var(--accent2); background: var(--surface2); padding: 1px 6px; border-radius: 5px; }
    .card-link { margin-top: auto; padding-top: var(--s-3); font-size: var(--fs-sm); font-weight: 600; }

    .skill-h { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); min-width: 0; }
    .skill-h h3 { font-family: var(--mono); font-size: 14px; min-width: 0; overflow-wrap: anywhere; }
    .vtag { font-family: var(--mono); font-size: 11px; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 2px 8px; white-space: nowrap; flex: 0 0 auto; }
    .skill-f { font-family: var(--mono); font-size: 11px; color: var(--subtle); margin-top: var(--s-3); }
    /* A skill's description is its activation text, written for the model and often
       past a thousand characters. Show the opening; the script adds the toggle only
       to the cards where it is genuinely cut. */
    .skill-desc { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; line-clamp: 4; overflow: hidden; }
    .skill-desc.is-open { display: block; overflow: visible; }
    .skill-more { align-self: flex-start; margin-top: var(--s-2); padding: 0; background: none; border: 0; cursor: pointer; font: inherit; font-size: 12px; color: var(--accent); }
    .skill-more:hover { text-decoration: underline; }

    /* Before/after comparison: a faint dot-grid backdrop fades in behind the cards. */
    #difference { position: relative; }
    #difference::before { content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
        background-image: radial-gradient(circle at 1px 1px, var(--dot) 1px, transparent 0); background-size: 22px 22px;
        -webkit-mask: radial-gradient(62% 56% at 50% 42%, #000, transparent 75%); mask: radial-gradient(62% 56% at 50% 42%, #000, transparent 75%); }
    #difference .wrap { position: relative; z-index: 1; }

    /* Comparison content (the window chrome lives in Compare.astro). */
    .cmp-list { max-width: 920px; margin: 0 auto; }
    .cmp-code { margin: 0; font-family: var(--mono); font-size: 12px; line-height: 1.75; color: var(--text); white-space: pre; overflow-x: auto; }
    .cmp-win.bad .cmp-code { color: var(--muted); }
    .cmp-code .kw { color: var(--accent); }
    .cmp-code .str { color: var(--good); }
    .cmp-code .dim { color: var(--subtle); }
    .cmp-code .k { color: var(--good); user-select: none; }
    .cmp-code .g { color: var(--good); }
    .cmp-code .r { color: var(--danger); }
    .cmp-prose { margin: 0; font-size: 13.5px; line-height: 1.62; }
    .cmp-win.bad .cmp-prose { color: var(--muted); }
    .cmp-win.good .cmp-prose { color: var(--text); }
    .cmp-lines { display: inline-block; font-family: var(--mono); font-size: 10px; letter-spacing: 0.3px; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 1px 9px; margin-bottom: 10px; }

    .shot { margin: var(--s-2) auto 0; }
    .shot img { width: 100%; height: auto; border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-2); display: block; }
    .dash-cta { text-align: center; margin-top: var(--s-6); }

    .compare { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow-x: auto; box-shadow: var(--shadow-1); }
    .compare table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 520px; }
    .compare th, .compare td { text-align: left; padding: 13px 18px; border-bottom: 1px solid var(--border-soft); }
    .compare th { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.6px; color: var(--muted); }
    .compare thead th:nth-child(2) { color: var(--accent); }
    .compare tbody tr:last-child td { border-bottom: none; }
    .compare td:first-child { color: var(--muted); }
    .yes { color: var(--good); } .no { color: var(--accent2); }

    .bottom-card {
        text-align: center; padding: var(--s-12) var(--s-6); border-radius: calc(var(--radius) + 4px);
        background: radial-gradient(600px 260px at 50% 0%, var(--accent-weak), transparent 70%), var(--surface);
        border: 1px solid var(--border); box-shadow: var(--shadow-2);
    }
    .bottom-card .lede { margin-top: var(--s-3); }
    .bottom-cta { display: flex; gap: var(--s-3); justify-content: center; flex-wrap: wrap; margin-top: var(--s-6); }

    .ghb { display: inline-flex; align-items: center; font-family: var(--mono); font-size: 12px; margin: 0 var(--s-2); }
    .ghb a { color: var(--text); }
    .ghb-btn { display: inline-flex; align-items: center; gap: 6px; background: var(--surface2); border: 1px solid var(--border); border-radius: 8px 0 0 8px; padding: 6px 11px; font-weight: 600; }
    .ghb-btn svg { width: 14px; height: 14px; }
    .ghb-btn:hover { color: var(--accent); background: var(--surface-hover); }
    .ghb-count { position: relative; background: var(--surface); border: 1px solid var(--border); border-left: none; border-radius: 0 8px 8px 0; padding: 6px 11px 6px 12px; font-variant-numeric: tabular-nums; }
    .ghb-count::before { content: ""; position: absolute; left: -4.5px; top: 50%; transform: translateY(-50%) rotate(45deg); width: 8px; height: 8px; background: var(--surface); border-left: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .ghb-count:hover { color: var(--accent); }

    .site-foot { border-top: 1px solid var(--border-soft); padding: var(--s-8) 0; color: var(--muted); font-size: var(--fs-sm); }
    .site-foot .wrap { display: flex; gap: var(--s-4) var(--s-6); align-items: center; flex-wrap: wrap; }
    .site-foot .brand { font-size: 15px; }
    .foot-links { display: flex; gap: var(--s-2) var(--s-5); flex-wrap: wrap; }
    .foot-links a { color: var(--muted); }
    .foot-links a:hover { color: var(--text); }
    .foot-icons { margin-left: auto; display: flex; gap: var(--s-2); }
    .foot-icons a { color: var(--muted); display: inline-flex; padding: 6px; border-radius: 8px; }
    .foot-icons a:hover { color: var(--accent); background: var(--surface); }
    .foot-icons svg { width: 18px; height: 18px; display: block; }

    @media (max-width: 760px) {
        .site-nav .links .hide-sm { display: none; }
        .nav-toggle { display: flex; }
        header.hero { padding: var(--s-12) 0 var(--s-8); }
        section { padding: var(--s-16) 0; }
        .hero-cta .btn { flex: 1 1 100%; }
        .card { padding: var(--s-5); }
    }
    @media (max-width: 480px) {
        .wrap { padding: 0 var(--s-4); }
        .foot-icons { margin-left: 0; }
    }
</style>

<script>
    // The install picker (tabs + copy + navigate-to-/start) lives in InstallTabs.astro; this
    // page only wires the skills catalog and the live star count.

    // Mobile nav: the hamburger opens/closes the left drawer. Closing waits for the slide-out
    // transition before re-hiding the overlay; the backdrop, close button and any link (all
    // tagged data-close) close it, as does Escape.
    (function () {
        const toggle = document.getElementById("navToggle");
        const menu = document.getElementById("mobileMenu");
        if (!toggle || !menu) return;
        let closeTimer;
        const open = () => {
            clearTimeout(closeTimer);
            menu.hidden = false;
            requestAnimationFrame(() => menu.classList.add("open"));
            toggle.setAttribute("aria-expanded", "true");
            document.body.style.overflow = "hidden";
        };
        const close = () => {
            menu.classList.remove("open");
            toggle.setAttribute("aria-expanded", "false");
            document.body.style.overflow = "";
            closeTimer = setTimeout(() => { menu.hidden = true; }, 280);
        };
        toggle.addEventListener("click", () => (menu.classList.contains("open") ? close() : open()));
        menu.addEventListener("click", (e) => { if (e.target.closest("[data-close]")) close(); });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape" && menu.classList.contains("open")) close(); });
    })();

    // Skills marketplace: the official catalog is generated by `enigma seal` into
    // docs/skills-catalog.json (single source of truth) and read here over GitHub raw
    // (CORS-open, no auth). Fault-tolerant: any failure leaves a friendly message.
    (function () {
        const grid = document.getElementById("skillsGrid");
        if (!grid) return;
        const CATALOG = "https://raw.githubusercontent.com/FJRG2007/enigma/main/docs/skills-catalog.json";
        const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]!));
        const ago = (iso: string) => {
            if (!iso) return "";
            const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86400000);
            if (days <= 0) return "today";
            if (days === 1) return "yesterday";
            if (days < 30) return `${days} days ago`;
            if (days < 365) return `${Math.floor(days / 30)} month${days < 60 ? "" : "s"} ago`;
            return `${Math.floor(days / 365)} year${days < 730 ? "" : "s"} ago`;
        };
        fetch(CATALOG, { cache: "no-store" })
            .then((r) => r.json())
            .then((c) => {
                const skills = (c.skills || []).slice().sort((a: any, b: any) => +new Date(b.updated || 0) - +new Date(a.updated || 0));
                if (!skills.length) { grid.innerHTML = '<p class="muted">No skills found.</p>'; return; }
                grid.innerHTML = skills.map((s: any) => {
                    const version = s.version ? `<span class="vtag">v${esc(s.version)}</span>` : "";
                    const edited = s.updated
                        ? `<div class="skill-f" title="${esc(new Date(s.updated).toLocaleString())}">Edited ${esc(ago(s.updated))}</div>`
                        : "";
                    return `<div class="card skill">
                        <div class="skill-h"><h3>${esc(s.name)}</h3>${version}</div>
                        <p class="skill-desc">${esc(s.description || "")}</p>
                        ${edited}
                    </div>`;
                }).join("");

                // A skill's description is its ACTIVATION text - written so the model
                // picks the right skill, not to be read end to end. Some run past a
                // thousand characters, so the card shows the opening and expands on
                // request, and the control only appears where the text really is cut.
                for (const description of Array.from(grid.querySelectorAll<HTMLElement>(".skill-desc"))) {
                    if (description.scrollHeight - description.clientHeight < 4) continue;
                    const toggle = document.createElement("button");
                    toggle.type = "button";
                    toggle.className = "skill-more";
                    toggle.textContent = "Show more";
                    toggle.setAttribute("aria-expanded", "false");
                    toggle.addEventListener("click", () => {
                        const open = description.classList.toggle("is-open");
                        toggle.textContent = open ? "Show less" : "Show more";
                        toggle.setAttribute("aria-expanded", String(open));
                    });
                    description.after(toggle);
                }
            })
            .catch(() => { grid.innerHTML = '<p class="muted">Could not load the skills catalog. Try again later.</p>'; });
    })();

    // Live GitHub star count (unauthenticated, CORS-open; rate-limited per IP).
    fetch("https://api.github.com/repos/FJRG2007/enigma")
        .then((r) => r.json())
        .then((d) => {
            const n = Number(d.stargazers_count);
            if (!Number.isFinite(n)) return;
            document.getElementById("stars")!.textContent = n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, "")}k` : String(n);
        })
        .catch(() => { /* keep the placeholder */ });
</script>
