    /* Sections: alternate a faint band so long pages read as distinct chapters. */
    section { padding: var(--s-20) 0; }
    section.band { background: var(--bg-band); border-block: 1px solid var(--border-soft); }
    .s-head { text-align: center; max-width: 62ch; margin: 0 auto var(--s-10); }
    .s-head .eyebrow { display: block; }
    h2 { font-family: var(--sans); font-size: var(--fs-h2); font-weight: 750; line-height: 1.15; letter-spacing: -0.025em; margin: var(--s-3) 0 0; text-wrap: balance; }
