---
import Base from "../layouts/Base.astro";
import { url, asset, docHref } from "../lib/url";
import Compare from "../components/Compare.astro";
import InstallTabs from "../components/InstallTabs.astro";

const title = "Enigma - everything you need to work with a coding agent, in one command";
const description = "Enigma makes your coding agent ship more optimal, secure and scalable code - in less time, fewer tokens and fewer iterations. Dynamic Skills for Claude Code, OpenAI Codex, opencode and Kimi Code, portable git security hooks, and a local dashboard to manage and measure it all - from one command.";

// One source for the nav, rendered as the desktop links and the mobile drawer list. Only
// destinations that leave this page: its own sections are one scroll away, and each extra
// anchor was one more item competing with the two that matter (Docs and Install).
const navLinks = [
    { href: docHref("getting-started/introduction"), label: "Docs" },
    { href: docHref("components/overview"), label: "Components" },
    { href: docHref("packs"), label: "Packs" },
    { href: url("demo/"), label: "Demo" },
];

// Before/after artifacts for the comparison section. Rendered with set:html (controlled,
// no user input) so literal braces in code don't collide with Astro's expression syntax.
const commitBad = `update stuff

<span class="dim">🤖 Generated with Claude Code</span>
<span class="dim">Co-Authored-By: Claude &lt;noreply@anthropic.com&gt;</span>`;
const commitGood = `<span class="g">✨ feat(auth):</span> add PKCE token refresh
<span class="g">🐛 fix(api):</span>   retry 429s with backoff
<span class="g">♻️ refactor(db):</span> extract query builder`;

const codeBad = `<span class="dim">// EnvManager.ts</span>
<span class="kw">export class</span> EnvManager {
  <span class="kw">private static</span> instance: EnvManager;
  <span class="kw">private</span> cache = <span class="kw">new</span> Map&lt;string, string&gt;();
  <span class="kw">static</span> getInstance() {
    <span class="kw">if</span> (!this.instance) this.instance = <span class="kw">new</span> EnvManager();
    <span class="kw">return</span> this.instance;
  }
  get(key: string, fb?: string) {
    <span class="kw">if</span> (this.cache.has(key)) <span class="kw">return</span> this.cache.get(key)!;
    <span class="kw">const</span> v = process.env[key] ?? fb;
    <span class="kw">if</span> (v == undefined) <span class="kw">throw new</span> Error(<span class="str">"Missing "</span> + key);
    this.cache.set(key, v); <span class="kw">return</span> v;
  }
}`;
const codeGood = `<span class="kw">export function</span> env(key: string, fb?: string) {
  <span class="kw">const</span> v = process.env[key] ?? fb;
  <span class="kw">if</span> (v == <span class="kw">null</span>) <span class="kw">throw new</span> Error(<span class="str">"Missing "</span> + key);
  <span class="kw">return</span> v;
}`;

const termBad = `<span class="k">$</span> git add .env
<span class="k">$</span> git commit -m <span class="str">"wip"</span>
[main 4f2a1c8] wip
 2 files changed, 18 insertions(+)
<span class="k">$</span> git push        <span class="dim"># .env + key now public</span>`;
const termGood = `<span class="k">$</span> git add .env
<span class="k">$</span> git commit -m <span class="str">"wip"</span>
<span class="r">enigma-guard: BLOCKED - 2 problem(s):</span>
<span class="r">  x .env  [env file with secrets]</span>
<span class="r">  x src/config.ts:12  [secret: Anthropic API key]</span>
<span class="dim">commit aborted.</span>`;
const REPO = "https://github.com/FJRG2007/enigma";

// The feature list, grouped so it scales: a new capability is one entry in the group it
// belongs to, not another card appended to a wall of fourteen. `body` is trusted static
// markup (inline <code>/<strong> only).
interface Feature { title: string; body: string; href?: string; link?: string; }
const featureGroups: { title: string; items: Feature[]; }[] = [
    {
        title: "Inside your agent",
        items: [
            { title: "Dynamic Skills, everywhere", body: "Senior-engineering policies (security, testing, git, style, debugging...) on Claude Code, Codex, opencode and Kimi Code. Each adapts to the agent and your config, loads by context, and updates itself.", href: docHref("concepts/dynamic-skills") },
            { title: "Per-agent scoping", body: "Keep a skill for Claude Code but not opencode. Turn any skill on or off per agent, from the CLI, the TUI or the dashboard." },
            { title: "Codebase memory", body: "A local graph of your code that agents query instead of re-exploring the repo: where a task's code lives, what a change breaks, a file's API surface.", href: docHref("concepts/code-graph") },
            { title: "Session recall", body: "A searchable memory of your past coding sessions, built from your own transcripts and served to agents over MCP. Stays on your machine.", href: docHref("concepts/recall") },
            { title: "Browser testing", body: "Agents open the app in a real, isolated Chrome to click through it and read the console, network, trace and Lighthouse audit before calling a UI change done." },
            { title: "Context compression", body: "A native engine that shrinks large tool outputs, logs and text before they reach the model - the same information in far fewer tokens, reversibly." },
        ],
    },
    {
        title: "Guards and checks",
        items: [
            { title: "Git security hooks", body: "A portable, dependency-free commit guard: blocks secrets, <code>.env</code> files and dependency dirs before they are committed. Set it up once and the whole team inherits it." },
            { title: "Convention guardrails", body: "Skills persuade; guardrails <strong>enforce</strong>. A post-edit hook scans what the agent writes and feeds any violation back so it self-corrects - zero tokens until there is one.", href: docHref("concepts/guardrails") },
            { title: "Verified completion", body: "When an agent says it is done, enigma checks the claim against what the turn produced and <strong>denies the stop</strong> when the evidence contradicts it.", href: docHref("concepts/verify") },
            { title: "AI quality gate", body: "Validates a branch in a disposable worktree - review, test, docs, lint, push, PR, CI - and opens a clean PR only when every check is green.", href: docHref("concepts/gate") },
            { title: "Built-in <code>/improve</code>", body: "A slash command on every agent: implement mode edits a focused area (ui, security, performance...); advisor mode audits and writes plans for another agent to run.", href: docHref("slash-commands/improve") },
            { title: "Built-in <code>/qa</code>", body: "Where <code>/improve</code> reviews the code, <code>/qa</code> reviews the experience: it uses the product like someone who depends on it and fixes what fails them.", href: docHref("slash-commands/qa") },
        ],
    },
    {
        title: "Around your agent",
        items: [
            { title: "Local dashboard", body: "A loopback control panel for accounts, skills, settings and system cleanup, with real Claude usage and measured savings. Nothing leaves your machine." },
            { title: "Multi-account and profiles", body: "Several logins per tool without logging out, each in its own config dir. Profiles pin one account per tool and drive every launch." },
            { title: "Design extraction", body: "<code>enigma design</code> turns a live site, a project or a git repo into a <code>DESIGN.md</code> and a skill: palette, type scale, spacing, motion and components.", href: docHref("concepts/design") },
            { title: "Packs", body: "Isolated harness packs on demand: <strong>Helio</strong> for bug bounty, <strong>Orion</strong> for broken flows, speed and scale. Neither loads into your normal agent.", href: docHref("packs") },
            { title: "Auto-detect skills by stack", body: "<code>enigma autoskills</code> reads your project and installs the matching community skills for React, Next.js, Astro, Prisma, Rails and ~90 more.", href: docHref("concepts/autoskills") },
            { title: "Local agent API and SSH", body: "<code>enigma api</code> serves your local agents over one OpenAI-compatible API; <code>enigma ssh</code> saves each server once and tunnels ports by name.", href: docHref("concepts/api") },
        ],
    },
];

const GITHUB_PATH = "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.52 11.52 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";
const DISCORD_PATH = "M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286ZM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189Zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9461 2.4189-2.1568 2.4189Z";
---
<Base title={title} description={description}>
    <nav class="site-nav">
        <div class="wrap bar">
            <button class="nav-toggle" id="navToggle" type="button" aria-label="Open menu" aria-controls="mobileMenu" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
            <a class="brand" href={url("")} aria-label="Enigma home">Enigma<span class="caret" aria-hidden="true"></span></a>
            <span class="links">
                {navLinks.map((l) => <a href={l.href} class="hide-sm">{l.label}</a>)}
                <span class="ghb hide-sm">
                    <a class="ghb-btn" href={REPO} target="_blank" rel="noopener noreferrer" aria-label="Star FJRG2007/enigma on GitHub">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={GITHUB_PATH}></path></svg>
                        Star
                    </a>
                    <a class="ghb-count" href={`${REPO}/stargazers`} target="_blank" rel="noopener noreferrer" aria-label="enigma stargazers"><span id="stars">&middot;</span></a>
                </span>
                <a href={url("start/")} class="btn sm">Install</a>
            </span>
        </div>
    </nav>

    <div class="mnav" id="mobileMenu" hidden>
        <aside class="mnav-panel" role="dialog" aria-modal="true" aria-label="Menu">
            <div class="mnav-head">
                <span class="brand">Enigma<span class="caret" aria-hidden="true"></span></span>
                <button class="mnav-close" type="button" data-close aria-label="Close menu">&times;</button>
            </div>
            <nav class="mnav-links">
                {navLinks.map((l) => <a href={l.href} data-close>{l.label}</a>)}
                <a class="mnav-gh" href={REPO} target="_blank" rel="noopener noreferrer" data-close>GitHub</a>
                <a href={url("start/")} class="btn" data-close>Install</a>
            </nav>
        </aside>
    </div>

    <header class="hero">
        <div class="wrap">
            <span class="hero-pill"><span class="dot" aria-hidden="true"></span>One command. Every agent.</span>
            <h1>Ship better code with your <span class="hl">coding agent</span></h1>
            <p class="lede">Enigma makes your agent produce more optimal, secure and scalable code - in less time, fewer tokens and fewer iterations. Dynamic Skills, git security hooks and a local dashboard, from one command.</p>

            <div class="install-wrap">
                <InstallTabs next={url("start/")} />
            </div>

            <div class="works">
                <span class="works-label">Works with</span>
                <span class="row"><img src={asset("logos/claude.svg")} alt="" width="22" height="22" /> Claude Code</span>
                <span class="row"><img src={asset("logos/openai.svg")} alt="" width="22" height="22" /> Codex</span>
                <span class="row"><img src={asset("logos/opencode.svg")} alt="" width="22" height="22" /> opencode</span>
                <span class="row"><img src={asset("logos/kimi.svg")} alt="" width="22" height="22" /> Kimi Code</span>
            </div>

            <div class="hero-cta">
                <a class="btn" href={url("start/")}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg>
                    Get started
                </a>
                <a class="btn ghost" href={url("demo/")}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                    Dashboard demo
                </a>
            </div>
        </div>
    </header>

    <section id="features" class="band">
        <div class="wrap">
            <div class="s-head">
                <span class="eyebrow">What you get</span>
                <h2>Production engineering, deployed into your agent</h2>
                <p>Authored once, deployed to every agent you select, and kept current automatically.</p>
            </div>
            {featureGroups.map((group) => (
                <div class="fgroup">
                    <h3 class="fgroup-h">{group.title}</h3>
                    <div class="grid">
                        {group.items.map((f) => (
                            <div class="card">
                                <h4 set:html={f.title}></h4>
                                <p set:html={f.body}></p>
                                {f.href && <a class="card-link" href={f.href}>{f.link ?? "Learn more"} &rarr;</a>}
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </section>

    <section id="difference">
        <div class="wrap">
            <div class="s-head">
                <span class="eyebrow">Before / after</span>
                <h2>Same agent. Sharper output.</h2>
                <p>Enigma doesn't swap your model - it changes what comes out of it. The left is a coding agent on its defaults; the right is the same agent with enigma's policies, guard and output discipline.</p>
            </div>
            <div class="cmp-list">
                <Compare topic="Commit messages" badFile="git log" goodFile="git log">
                    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><line x1="3" y1="12" x2="9" y2="12"></line><line x1="15" y1="12" x2="21" y2="12"></line></svg>
                    <pre slot="without" class="cmp-code" set:html={commitBad}></pre>
                    <pre slot="with" class="cmp-code" set:html={commitGood}></pre>
                </Compare>

                <Compare topic="Code structure" badFile="EnvManager.ts" goodFile="env.ts" note="Minimal-code (anti-overengineering): stdlib and native first, no speculative abstraction, the shortest diff that works.">
                    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                    <Fragment slot="without">
                        <span class="cmp-lines">16 lines - singleton + cache</span>
                        <pre class="cmp-code" set:html={codeBad}></pre>
                    </Fragment>
                    <Fragment slot="with">
                        <span class="cmp-lines">5 lines - same job</span>
                        <pre class="cmp-code" set:html={codeGood}></pre>
                    </Fragment>
                </Compare>

                <Compare topic="Secrets and .env guard" badFile="bash" goodFile="bash" note="The commit guard ships in every repo you run enigma security in - it blocks secrets, .env files and dependency dirs before they ever reach a commit.">
                    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    <pre slot="without" class="cmp-code" set:html={termBad}></pre>
                    <pre slot="with" class="cmp-code" set:html={termGood}></pre>
                </Compare>

                <Compare topic="Descriptions and copy" badFile="README.md" goodFile="README.md">
                    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="14" y2="12"></line><line x1="4" y1="17" x2="18" y2="17"></line></svg>
                    <p slot="without" class="cmp-prose">Our revolutionary, next-generation platform &mdash; engineered from the ground up &mdash; leverages cutting-edge AI to seamlessly supercharge your workflow, unlock unprecedented synergy, and deliver world-class results &mdash; and so much more.</p>
                    <p slot="with" class="cmp-prose">Installs shared engineering skills into your coding agent, blocks secrets before they reach a commit, and manages everything from one local dashboard.</p>
                </Compare>

                <Compare topic="Token-efficient output" badFile="assistant" goodFile="assistant" note="Three compression levels (lite / full / ultra) shape every reply: same technical content, answers sized to the question, fewer tokens per turn.">
                    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                    <p slot="without" class="cmp-prose">Sure! I'd be happy to help you with that. Let me start by taking a careful look at the existing code so I can fully understand how everything is currently structured, and then I'll go ahead and make the changes needed to address the issue you've described.</p>
                    <p slot="with" class="cmp-prose">Reading the existing code, then fixing the issue.</p>
                </Compare>
            </div>
        </div>
    </section>

    <section id="efficiency" class="band">
        <div class="wrap">
            <div class="s-head">
                <span class="eyebrow">Less friction, fewer tokens</span>
                <h2>Defaults that stop wasting your time</h2>
                <p>Enigma turns off the noise and turns on the shortcuts the moment you install - so every session is faster, quieter and cheaper.</p>
            </div>
            <div class="grid">
                <div class="card"><h3>No approval prompts</h3><p>Permission bypass is on by default, so the agent stops asking before every action and just works. A deliberate security trade-off you can opt out of globally or per agent.</p></div>
                <div class="card"><h3>No feedback surveys</h3><p>Claude Code's feedback survey is switched off at install, so it never interrupts you mid-flow.</p></div>
                <div class="card"><h3>Right the first time</h3><p>Specialized policy skills (security, testing, git, style, debugging...) mean fewer wrong turns and re-prompts - which means fewer tokens and less of your time.</p></div>
                <div class="card"><h3>No telemetry</h3><p>GitHub CLI telemetry is disabled at install (and it sidesteps a Windows console-flash bug too). Nothing phones home.</p></div>
                <div class="card"><h3>Fewer tokens per turn</h3><p>Opt-in token-efficient output and a native context-compression engine shrink prompts and tool output - the same work for fewer tokens.</p></div>
                <div class="card"><h3>Clean git history</h3><p>The agent is kept from attributing commits to itself, so your history stays yours - nothing to undo later.</p></div>
            </div>
        </div>
    </section>

    <section id="skills">
        <div class="wrap">
            <div class="s-head">
                <span class="eyebrow">Dynamic Skills</span>
                <h2>Skills that adapt, not just deploy</h2>
                <p>Unlike a static skill, each enigma skill adapts to the app that runs it, re-renders from your config, and loads by context - sealed, versioned, and updated straight from the repo. <a href={docHref("concepts/dynamic-skills")}>How Dynamic Skills work &rarr;</a> Newest edits first.</p>
            </div>
            <div class="grid" id="skillsGrid"><p class="muted">Loading skills...</p></div>
        </div>
    </section>

    <section id="components" class="band">
        <div class="wrap">
            <div class="s-head">
                <span class="eyebrow">Headless components</span>
                <h2>Behaviour you install, not code you rewrite</h2>
                <p>Interaction logic is behaviour, and behaviour that has already been measured and tested belongs in a package. Add it as a dependency, or copy the source in and own it. No styles of their own - the look stays yours. <a href={docHref("components/overview")}>How components work &rarr;</a></p>
            </div>
            <div class="grid">
                <div class="card">
                    <div class="skill-h"><h3>marquee</h3><span class="vtag">primitives</span></div>
                    <p>A looping row that can be grabbed and thrown - logo walls, testimonial strips, pill rails. Takes a speed in px/s, never a duration, so it does not accelerate every time you add an item.</p>
                    <a class="card-link" href={docHref("components/marquee")}>Documentation &rarr;</a>
                </div>
                <div class="card">
                    <div class="skill-h"><h3>cache</h3><span class="vtag">utils</span></div>
                    <p>Short-TTL read cache whose point is the in-flight deduplication: two components asking for one key make one request, not five, so a rate limit sees one.</p>
                    <a class="card-link" href={docHref("components/cache")}>Documentation &rarr;</a>
                </div>
                <div class="card">
                    <div class="skill-h"><h3>notifications</h3><span class="vtag">utils</span></div>
                    <p>Ordering, dedupe by key and sticky errors, with dismiss timers that hold rather than run while the tab is hidden. Rendering stays yours.</p>
                    <a class="card-link" href={docHref("components/notifications")}>Documentation &rarr;</a>
                </div>
            </div>
            <div class="s-cta">
                <a class="btn" href={docHref("components/overview")}>Browse the components</a>
                <a class="btn ghost" href={docHref("components/marquee")}>See the marquee API</a>
            </div>
        </div>
    </section>

    <section id="dashboard">
        <div class="wrap">
            <div class="s-head">
                <span class="eyebrow">One place for everything</span>
                <h2>Manage enigma from your browser</h2>
                <p>A local control panel for the whole thing: switch accounts and profiles, enable or edit skills per app, change any setting, and free up your machine (kill a port, shut down WSL, quit Docker). It also shows real Claude usage and the savings enigma can measure - honest by design.</p>
            </div>
            <div class="shot"><img src={asset("dashboard.png")} alt="The Enigma dashboard" loading="lazy" /></div>
            <div class="dash-cta"><a class="btn" href={url("demo/")}>Explore the live demo</a></div>
        </div>
    </section>

    <section id="compare" class="band">
        <div class="wrap">
            <div class="s-head">
                <span class="eyebrow">Why Enigma</span>
                <h2>One install instead of a dozen</h2>
            </div>
            <div class="compare">
                <table>
                    <thead><tr><th>Setup task</th><th>With Enigma</th><th>By hand</th></tr></thead>
                    <tbody>
                        <tr><td>Shared skills across Claude Code, Codex, opencode, Kimi Code</td><td class="yes">One command</td><td class="no">Per-agent, by hand</td></tr>
                        <tr><td>Skills kept current</td><td class="yes">Auto-sync + GitHub updates</td><td class="no">Manual re-copy</td></tr>
                        <tr><td>Per-agent skill selection</td><td class="yes">Built in</td><td class="no">Not available</td></tr>
                        <tr><td>Commit secret/.env guard</td><td class="yes">Portable, team-shareable</td><td class="no">Ad-hoc scripts</td></tr>
                        <tr><td>Dashboard to manage it all</td><td class="yes">Local, loopback-only</td><td class="no">None</td></tr>
                        <tr><td>Multi-account switching</td><td class="yes">OS-agnostic, no aliases</td><td class="no">Shell hacks</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section id="contribute">
        <div class="wrap">
            <div class="s-head">
                <span class="eyebrow">Open source</span>
                <h2>Propose an improvement</h2>
                <p>The skills are just Markdown in the repo. Improve one and share it back, whichever way suits you - the dashboard's "Propose an improvement" button opens the exact file on GitHub.</p>
            </div>
            <div class="grid">
                <div class="card"><h3>Open a pull request</h3><p>Edit a skill's <code>SKILL.md</code> <a href="https://github.com/FJRG2007/enigma/tree/main/packages/enigma-cli/assets/skills" target="_blank" rel="noopener noreferrer">on GitHub</a> and open a PR. It is reviewed, sealed and shipped to everyone.</p></div>
                <div class="card"><h3>File an issue</h3><p>Not sure how to change it? <a href="https://github.com/FJRG2007/enigma/issues/new/choose" target="_blank" rel="noopener noreferrer">Open an issue</a> describing the improvement and we will take it from there.</p></div>
                <div class="card"><h3>Chat on Discord</h3><p>Bounce ideas off the community on <a href="https://tpe.li/dsc" target="_blank" rel="noopener noreferrer">Discord</a> before you build.</p></div>
            </div>
        </div>
    </section>

    <section class="bottom">
        <div class="wrap">
            <div class="bottom-card">
                <span class="eyebrow">Ready in one line</span>
