<style is:global>
    body {
        background:
            radial-gradient(1100px 620px at 80% -10%, var(--glow-1), transparent 58%),
            radial-gradient(820px 520px at 4% 2%, var(--glow-2), transparent 52%),
            var(--bg);
        background-attachment: fixed;
    }

    /* Mobile nav: a hamburger button (hidden on desktop) opens a left off-canvas drawer. */
    .nav-toggle { display: none; flex-direction: column; justify-content: center; gap: 4px; width: 40px; height: 40px; padding: 0 9px; margin-left: -8px; background: none; border: 0; cursor: pointer; }
    .nav-toggle span { display: block; height: 2px; width: 20px; background: var(--text); border-radius: 2px; transition: transform .22s ease, opacity .22s ease; }
    .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

    .mnav { position: fixed; inset: 0; z-index: 40; }
    .mnav[hidden] { display: none; }
    .mnav-panel { position: absolute; inset: 0; width: 100%; height: 100%; background: var(--bg); padding: var(--s-4) var(--s-5) var(--s-8); display: flex; flex-direction: column; transform: translateX(-100%); transition: transform .26s cubic-bezier(.4, 0, .2, 1); overflow-y: auto; overscroll-behavior: contain; }
    .mnav.open .mnav-panel { transform: none; }
    .mnav-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--s-2); }
    .mnav-close { background: none; border: 0; color: var(--muted); font-size: 26px; line-height: 1; cursor: pointer; padding: 2px 8px; }
    .mnav-close:hover { color: var(--text); }
    .mnav-links { display: flex; flex-direction: column; gap: 2px; margin-top: var(--s-2); font-size: var(--fs-md); }
    .mnav-links a:not(.btn) { color: var(--muted); padding: 12px 8px; border-radius: 8px; }
    .mnav-links a:not(.btn):hover { color: var(--text); background: var(--surface2); }
    /* A divider above the external link, drawn apart from the link so its rounded hover box stays rounded. */
    .mnav-links .mnav-gh { position: relative; margin-top: 17px; }
    .mnav-links .mnav-gh::before { content: ""; position: absolute; left: 0; right: 0; top: -9px; height: 1px; background: var(--border-soft); }
    .mnav-links .btn { margin-top: var(--s-3); padding: 13px; }

    /* Hero. */
    header.hero { padding: var(--s-20) 0 var(--s-12); text-align: center; }
    .hero-pill {
        display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: var(--fs-xs); font-weight: 600;
        letter-spacing: 1.2px; text-transform: uppercase; color: var(--accent);
        background: var(--accent-weak); border: 1px solid var(--accent-line); border-radius: 999px; padding: 6px 12px;
    }
    .hero-pill .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--good); box-shadow: 0 0 0 3px var(--good-weak); }
    h1 {
        font-family: var(--sans); font-size: var(--fs-h1); line-height: 1.04; font-weight: 800;
        letter-spacing: -0.035em; margin: var(--s-5) auto 0; max-width: 15ch; text-wrap: balance;
    }
    h1 .hl { color: var(--accent); }
    .lede { color: var(--muted); font-size: var(--fs-lg); line-height: 1.6; max-width: 58ch; margin: var(--s-5) auto 0; text-wrap: pretty; }

    /* The install picker itself lives in InstallTabs.astro; the hero only centers it. */
    .install-wrap { max-width: 640px; margin: var(--s-8) auto 0; }

    .works { margin: var(--s-6) auto 0; display: flex; align-items: center; justify-content: center; gap: var(--s-3) var(--s-5); flex-wrap: wrap; color: var(--muted); font-size: var(--fs-sm); }
