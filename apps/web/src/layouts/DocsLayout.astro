---
import Base from "./Base.astro";
import { url, docHref } from "../lib/url";
import { getCollection } from "astro:content";
import { buildSearchIndex } from "../lib/search";
import CommandPalette from "../components/CommandPalette.astro";
import FrameworkPicker from "../components/FrameworkPicker.astro";

interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    title: string;
    description: string;
    slug: string;
    headings?: Heading[];
}
const { title, description, slug, headings = [] } = Astro.props;

// h2 and h3 only: h1 is the page title above, and h4 down is detail nobody navigates by.
const outline = headings.filter((h) => h.depth === 2 || h.depth === 3);

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const index = await buildSearchIndex();

// The active page decides which section (and which pack) the sidebar shows.
const current = docs.find((d) => d.id === slug);
const space = current?.data.space ?? "core";
const pack = current?.data.pack;
const label = (id: string) => id.charAt(0).toUpperCase() + id.slice(1);
const packLabel = pack ? label(pack) : "";

// Distinct packs in the Packs space, each linking to its landing (lowest-order) page.
const packList: { id: string; label: string; landing: string }[] = [];
for (const d of docs) {
    if (d.data.space === "packs" && d.data.pack && !packList.find((p) => p.id === d.data.pack)) {
        packList.push({ id: d.data.pack, label: label(d.data.pack), landing: d.id });
    }
}

// The docs shown in the sidebar for the current section. Each space owns its own list,
// so the component reference is not buried at the bottom of the core sidebar.
const sidebarDocs = space === "packs"
    ? (pack ? docs.filter((d) => d.data.pack === pack) : [])
    : docs.filter((d) => (d.data.space ?? "core") === space);

// Group the sidebar entries by their `group` frontmatter, preserving order.
const groups: { name: string; items: typeof docs }[] = [];
for (const d of sidebarDocs) {
    let g = groups.find((x) => x.name === d.data.group);
    if (!g) { g = { name: d.data.group, items: [] }; groups.push(g); }
    g.items.push(d);
}
const onPacksHub = space === "packs" && !pack;

const REPO = "https://github.com/FJRG2007/enigma";
const docSource = `${REPO}/edit/main/apps/web/src/content/docs/${slug}.mdx`;
// A component page is documentation OF something; the thing itself is the more useful
// link, so both are offered rather than guessing which one the reader wants.
const componentName = space === "components" && slug !== "components/overview" ? slug.split("/").pop() : null;
const componentPackage = componentName && ["cache", "notifications"].includes(componentName) ? "utils" : "primitives";
const componentSource = componentName
    ? `${REPO}/blob/main/packages/${componentPackage}/src/core/${componentName}.ts`
    : null;
---
<Base title={`${title} - Enigma docs`} description={description}>
    <nav>
        <div class="in">
            <a href={url("")} class="brand">Enigma<span class="c"></span></a>
            <div class="tabs">
                <a href={docHref("getting-started/introduction")} class={space === "core" ? "active" : ""}>Core</a>
                <a href={docHref("components/overview")} class={space === "components" ? "active" : ""}>Components</a>
                <a href={docHref("packs")} class={space === "packs" ? "active" : ""}>Packs</a>
            </div>
            {space === "components" && <FrameworkPicker />}
            <a class="home" href={url("")}>&larr; Home</a>
        </div>
    </nav>

    <div class="layout">
        <aside>
            <button class="docsearch" data-search-open type="button" aria-label="Search the documentation">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                <span>Search docs</span>
                <kbd>&#8984;K</kbd>
            </button>
            {space === "packs" && pack && (
                <>
                    <a class="backlink" href={docHref("packs")}>&larr; All packs</a>
                    <div class="packhdr">{packLabel}</div>
                </>
            )}
            {onPacksHub ? (
                <>
                    <div class="grp">Packs</div>
                    {packList.map((p) => (
                        <a href={docHref(p.landing)} class={p.landing === slug ? "active" : ""}>{p.label}</a>
                    ))}
                </>
            ) : (
                groups.map((g) => (
                    <>
                        <div class="grp">{g.name}</div>
                        {g.items.map((d) => (
                            <a href={docHref(d.id)} class={d.id === slug ? "active" : ""}>{d.data.title}</a>
                        ))}
                    </>
                ))
            )}
        </aside>

        <main>
            <h1>{title}</h1>
            <p class="sub">{description}</p>
            <article class="doc">
                <slot />
            </article>
        </main>

        <nav class="toc" aria-label="On this page">
            <div class="toc-inner">
                {outline.length > 0 && (
                    <>
                        <div class="toc-h">On this page</div>
                        <div class="toc-links">
                            {outline.map((heading) => (
                                <a href={`#${heading.slug}`} class:list={["toc-a", heading.depth === 3 && "is-sub"]} data-toc={heading.slug}>{heading.text}</a>
                            ))}
                        </div>
                    </>
                )}
                <div class="toc-src">
                    {componentSource && (
                        <a href={componentSource} target="_blank" rel="noopener noreferrer">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 16 4-4-4-4"></path><path d="m6 8-4 4 4 4"></path><path d="m14.5 4-5 16"></path></svg>
                            Component source
                        </a>
                    )}
                    <a href={docSource} target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4Z"></path></svg>
                        Edit this page
                    </a>
                </div>
            </div>
        </nav>
    </div>

    <footer>
        Enigma - <a href="https://github.com/FJRG2007/enigma" target="_blank" rel="noopener noreferrer">GitHub</a> - <a href="https://github.com/FJRG2007/enigma/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">Apache-2.0</a>
    </footer>

    <CommandPalette index={index} />
</Base>

<style is:global>
    nav { position: sticky; top: 0; z-index: 20; backdrop-filter: blur(10px); background: rgba(8, 10, 16, 0.72); border-bottom: 1px solid var(--border-soft); }
    nav .in { max-width: 1180px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 18px; height: 56px; }
    .brand { font-family: var(--mono); font-size: 17px; font-weight: 600; letter-spacing: 0.5px; color: var(--text); }
    .brand .c { display: inline-block; width: 0.46em; height: 1.05em; margin-left: 4px; background: var(--accent); transform: translateY(2px); }
    nav .tabs { display: flex; gap: 2px; margin-left: 10px; }
    nav .tabs a { font-family: var(--mono); font-size: 13px; color: var(--muted); padding: 6px 12px; border-radius: 7px; transition: color .15s, background .15s; }
    nav .tabs a:hover { color: var(--text); }
    nav .tabs a.active { color: var(--accent); background: var(--surface); }
    nav .in a.home { margin-left: auto; font-family: var(--mono); font-size: 13px; color: var(--muted); }
    nav .in a.home:hover { color: var(--text); }

    aside .backlink { display: block; font-family: var(--mono); font-size: 12px; color: var(--muted); padding: 4px 0; }
    aside .backlink:hover { color: var(--text); }
    aside .packhdr { font-family: var(--mono); font-size: 15px; font-weight: 600; color: var(--text); margin: 2px 0 6px; }

    .layout { max-width: 1400px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 210px minmax(0, 1fr) 190px; gap: 40px; }

    /* On this page. Sticky, and it tracks the heading currently under the top of the
       viewport so a long page does not lose the reader's place. */
    /* The layout aligns its items to the start, which leaves this column only as tall as
       its own content - and a sticky child cannot outlive its parent, so the outline
       scrolled away mid-page. Stretching it to the row is what makes sticky mean sticky. */
    /* A <nav>, not an <aside>: the generic `aside` rule the left sidebar needs sets
       `overflow: auto`, and ANY scrollable ancestor makes a sticky child stick inside THAT
       box rather than the viewport - the outline scrolled away with the page. Changing the
       element is what stops the rule applying; a semantic table of contents is a nav
       anyway. `align-self: stretch` is the other half: a sticky child cannot outlive a
       parent only as tall as its own content. */
    .toc {
        position: relative; align-self: stretch;
        /* The page's `nav` rule is written for the top bar and hands every nav a
           border-bottom, a translucent background, a backdrop filter and a z-index. This
           column is a nav to escape the `aside` overflow rule, so it has to hand all of
           that back - the border was showing as a stray line under the outline. */
        border: 0; background: none; backdrop-filter: none; z-index: auto;
    }
    .toc-inner { position: sticky; top: 84px; display: grid; gap: 18px; padding: 4px 0 40px; }
    .toc-h { font-family: var(--mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: .6px; color: var(--muted); }
    .toc-links { display: grid; gap: 7px; border-left: 1px solid var(--border-soft); }
    .toc-a { font-size: 12.5px; line-height: 1.35; color: var(--muted); text-decoration: none; padding: 1px 0 1px 12px; margin-left: -1px; border-left: 1px solid transparent; }
    .toc-a:hover { color: var(--text); }
    .toc-a.is-sub { padding-left: 24px; font-size: 12px; }
    .toc-a.is-active { color: var(--accent); border-left-color: var(--accent); }
    .toc-src { display: grid; gap: 8px; padding-top: 18px; }
    .toc-src a { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; color: var(--muted); text-decoration: none; }
    .toc-src a:hover { color: var(--text); }
    .toc-src svg { width: 13px; height: 13px; flex: 0 0 auto; }
    @media (max-width: 1200px) { .toc { display: none; } }
    /*
     * Pinned, and able to scroll on its own. `position: sticky` alone only pins the TOP of the
     * sidebar: once its content is taller than the viewport the rest keeps scrolling away with
     * the page and the last entries are unreachable. Bounding the height to the space under the
     * nav and giving it its own overflow is what makes it behave like a real sidebar; the
     * overscroll containment stops the page from scrolling on when the list hits its end.
     */
    aside {
        position: sticky; top: 72px; align-self: start; padding: 28px 0;
        max-height: calc(100vh - 72px); overflow-y: auto; overscroll-behavior: contain;
    }
    aside .grp { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.7px; color: var(--accent); margin: 18px 0 8px; }
    aside a { display: block; color: var(--muted); font-size: 13px; padding: 4px 0; }
    aside a:hover { color: var(--text); }
    aside a.active { color: var(--accent); }

    .docsearch {
        display: flex; align-items: center; gap: 8px; width: 100%; margin-bottom: 8px; cursor: pointer;
        background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm);
        color: var(--muted); font-family: var(--mono); font-size: 12.5px; padding: 8px 10px;
        transition: border-color .15s, color .15s;
    }
    .docsearch:hover { border-color: var(--accent); color: var(--text); }
    .docsearch svg { width: 14px; height: 14px; flex: 0 0 auto; }
    .docsearch span { flex: 1; text-align: left; }
    .docsearch kbd { font-family: var(--mono); font-size: 10.5px; background: var(--surface2); border: 1px solid var(--border); border-radius: 5px; padding: 1px 5px; }

    main { padding: 28px 0 80px; min-width: 0; }
    main > h1 { font-family: var(--mono); font-size: 28px; font-weight: 600; letter-spacing: -0.5px; margin: 0; }
    main > .sub { color: var(--muted); margin: 8px 0 0; }

    /* MDX content (slotted, so these are global selectors scoped under .doc). */
    .doc h2 { font-family: var(--mono); font-size: 18px; font-weight: 600; margin: 48px 0 4px; scroll-margin-top: 72px; display: flex; align-items: center; gap: 9px; }
    .doc h2::before { content: ""; width: 3px; height: 16px; border-radius: 2px; background: var(--accent); flex: 0 0 auto; }
    .doc h2 + p { color: var(--muted); margin-top: 6px; }
    .doc p { line-height: 1.65; }
    .doc code { font-family: var(--mono); font-size: 0.86em; color: var(--accent2); background: var(--surface2); padding: 1px 6px; border-radius: 5px; }
    /* Marks a documented technique that is not settled yet, so a reader knows before
       they build on it rather than after. */
    .doc .beta-tag {
        display: inline-block; font-family: var(--mono); font-size: 10px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .5px; color: var(--accent);
        border: 1px solid var(--border); border-radius: 999px; padding: 2px 8px;
        margin-right: 8px; vertical-align: 2px;
    }
    .doc a { color: var(--accent2); }
    .doc a:hover { color: var(--accent); }

    /* Code blocks: theme the Shiki output to the surface palette and host the copy button. */
    .doc pre { position: relative; background: var(--surface) !important; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px 16px; overflow-x: auto; font-size: 13px; line-height: 1.7; margin: 14px 0; }
    .doc pre code { background: transparent; color: inherit; padding: 0; font-size: 13px; }
    .doc .code-copy {
        position: absolute; top: 8px; right: 8px; display: inline-flex; align-items: center; justify-content: center;
        color: var(--muted); background: var(--surface2); border: 1px solid var(--border); border-radius: 7px;
        padding: 6px; cursor: pointer; opacity: 0; transition: opacity .14s, color .14s, border-color .14s;
    }
    .doc pre:hover .code-copy, .doc .code-copy:focus-visible { opacity: 1; }
    .doc .code-copy:hover { color: var(--accent); border-color: #2f3744; }
    .doc .code-copy.done { color: var(--good); border-color: var(--good); opacity: 1; }
    .doc .code-copy svg { width: 14px; height: 14px; display: block; }

    .doc table { width: 100%; border-collapse: collapse; font-size: 13.5px; margin: 14px 0; display: block; overflow-x: auto; }
    .doc th, .doc td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--border-soft); white-space: nowrap; }
    .doc th { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); }
    .doc td:first-child code { color: var(--accent); }
    .doc td.w { white-space: normal; min-width: 240px; }
    .doc .def { color: var(--good); }

    footer { border-top: 1px solid var(--border-soft); margin-top: 40px; padding: 24px; text-align: center; color: var(--muted); font-size: 13px; }

    /* Stacked on narrow screens: the sidebar is part of the page flow again, so it must drop
       the viewport height cap and its own scrollbar or it becomes a tiny scrolling box. */
    @media (max-width: 820px) {
        .layout { grid-template-columns: 1fr; }
        aside { position: static; padding: 16px 0 0; max-height: none; overflow-y: visible; }
    }
</style>

<script>
    // Highlight the heading the reader is actually at.
    //
    // Not an IntersectionObserver band: a section taller than the band leaves NO heading
    // inside it, and the marker vanishes mid-section - measured on this very page. Taking
    // the last heading above a trigger line always has an answer.
    const links: Map<string, HTMLAnchorElement> = new Map();
    for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-toc]")) {
        links.set(link.dataset.toc ?? "", link);
    }

    if (links.size > 0) {
        const headings: { id: string; element: HTMLElement; }[] = [];
        for (const id of links.keys()) {
            const element = document.getElementById(id);
            if (element) headings.push({ id, element });
        }

        let queued = false;
        const sync = () => {
            queued = false;
            const line = 100;
            let active = headings[0]?.id ?? null;
            for (const { id, element } of headings) {
                if (element.getBoundingClientRect().top > line) break;
                active = id;
            }
            // At the very bottom the last section may never reach the line.
            if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 2) {
                active = headings[headings.length - 1]?.id ?? active;
            }
            for (const [id, link] of links) link.classList.toggle("is-active", id === active);
        };

        const onScroll = () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(sync);
        };

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        sync();
    }
</script>

<script>
    // Add a hover copy button to every docs code block. Uses the async Clipboard API with a
    // synchronous execCommand fallback for when it is unavailable or blocked (e.g. a browser
    // clipboard-guard extension that breaks navigator.clipboard.writeText).
    const COPY = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
    const CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';

    function fallbackCopy(text: string): boolean {
        try {
            const ta = document.createElement("textarea");
            ta.value = text; ta.style.position = "fixed"; ta.style.opacity = "0";
            document.body.appendChild(ta); ta.focus(); ta.select();
            const ok = document.execCommand("copy");
            ta.remove();
            return ok;
        } catch { return false; }
    }

    document.querySelectorAll<HTMLPreElement>(".doc pre").forEach((pre) => {
        const code = pre.querySelector("code") ?? pre;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "code-copy";
        btn.setAttribute("aria-label", "Copy code");
        btn.innerHTML = COPY;
        btn.addEventListener("click", async () => {
            const text = (code as HTMLElement).innerText;
            let ok = false;
            try { await navigator.clipboard.writeText(text); ok = true; }
            catch { ok = fallbackCopy(text); }
            if (!ok) return;
            btn.innerHTML = CHECK; btn.classList.add("done");
            setTimeout(() => { btn.innerHTML = COPY; btn.classList.remove("done"); }, 1600);
        });
        pre.appendChild(btn);
    });
</script>
