{
  "registry": "@enigmax/utils",
  "version": 1,
  "kind": "utility",
  "items": [
    {
      "name": "cache",
      "title": "Short-TTL read cache",
      "description": "Read-through cache with in-flight deduplication, prefix invalidation and optional local/session persistence.",
      "targets": [
        "vanilla",
        "astro",
        "react"
      ],
      "entry": {
        "vanilla": "@enigmax/utils",
        "astro": "@enigmax/utils",
        "react": "@enigmax/utils/react"
      },
      "exports": {
        "vanilla": [
          "createCache"
        ],
        "astro": [
          "createCache"
        ],
        "react": [
          "useCached"
        ]
      },
      "files": [
        {
          "path": "src/core/cache.ts",
          "dest": "cache/cache.ts",
          "targets": [
            "vanilla",
            "astro",
            "react"
          ]
        },
        {
          "path": "src/react/use-cached.ts",
          "dest": "cache/use-cached.ts",
          "targets": [
            "react"
          ],
          "rewrite": {
            "@/core/cache": "./cache"
          },
          "main": true
        }
      ],
      "styles": false,
      "docs": "docs/notes/primitives.md#cache",
      "source": "src/core/cache.ts"
    },
    {
      "name": "password-breach",
      "title": "Breached-password check",
      "description": "Ask Have I Been Pwned whether a password has leaked, without sending it anywhere: it is hashed in the browser and only the first five characters of that hash are sent, so the service never learns which password was looked up. Reports a count and throws what it cannot do - what a breach means is the form's decision.",
      "targets": [
        "vanilla",
        "astro",
        "react"
      ],
      "entry": {
        "vanilla": "@enigmax/utils",
        "astro": "@enigmax/utils",
        "react": "@enigmax/utils"
      },
      "exports": {
        "vanilla": [
          "checkPasswordBreach"
        ],
        "astro": [
          "checkPasswordBreach"
        ],
        "react": [
          "checkPasswordBreach"
        ]
      },
      "files": [
        {
          "path": "src/core/cache.ts",
          "dest": "password-breach/cache.ts",
          "targets": [
            "vanilla",
            "astro",
            "react"
          ]
        },
        {
          "path": "src/core/password-breach.ts",
          "dest": "password-breach/index.ts",
          "main": true,
          "targets": [
            "vanilla",
            "astro",
            "react"
          ],
          "rewrite": {
            "@/core/cache": "./cache"
          }
        }
      ],
      "styles": false,
      "docs": "docs/notes/primitives.md#password-breach",
      "source": "src/core/password-breach.ts"
    },
    {
      "name": "safe-fetch",
      "title": "SSRF-safe fetch (server)",
      "description": "Fetch a URL that came from outside without letting it reach this machine, its network or the cloud metadata service. The address is vetted inside the socket's own DNS lookup, so the address checked is the address connected to and DNS rebinding cannot slip a private one in between; IP literals, every redirect hop, embedded credentials, size and time are checked too. Node only.",
      "targets": [
        "vanilla",
        "astro",
        "react",
        "vue",
        "svelte"
      ],
      "entry": {
        "vanilla": "@enigmax/utils/server",
        "astro": "@enigmax/utils/server",
        "react": "@enigmax/utils/server",
        "vue": "@enigmax/utils/server",
        "svelte": "@enigmax/utils/server"
      },
      "exports": {
        "vanilla": [
          "safeFetch",
          "isPublicAddress",
          "SafeFetchError"
        ],
        "astro": [
          "safeFetch",
          "isPublicAddress",
          "SafeFetchError"
        ],
        "react": [
          "safeFetch",
          "isPublicAddress",
          "SafeFetchError"
        ],
        "vue": [
          "safeFetch",
          "isPublicAddress",
          "SafeFetchError"
        ],
        "svelte": [
          "safeFetch",
          "isPublicAddress",
          "SafeFetchError"
        ]
      },
      "files": [
        {
          "path": "src/server/safe-fetch.ts",
          "dest": "safe-fetch/index.ts",
          "targets": [
            "vanilla",
            "astro",
            "react",
            "vue",
            "svelte"
          ],
          "main": true
        }
      ],
      "styles": false,
      "docs": "docs/notes/primitives.md#safe-fetch",
      "source": "src/server/safe-fetch.ts"
    },
    {
      "name": "safe-upload",
      "title": "Safe file upload (server)",
      "description": "Accept an upload by what its bytes are, against an allowlist and a size cap; store it under a random name; keep any path built from input under its root; serve it back with nosniff, a sandboxing CSP and a forced attachment for anything a browser would run. Node only.",
