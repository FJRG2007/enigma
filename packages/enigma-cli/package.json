{
  "name": "enigma-cli",
  "version": "1.1.4",
  "description": "Everything you need to work with a coding agent: install shared policy skills for Claude Code, OpenAI Codex and opencode, and set up portable git security hooks.",
  "type": "module",
  "bin": {
    "enigma": "dist/enigma.js"
  },
  "scripts": {
    "enigma": "tsx src/bin/enigma.ts",
    "build": "tsup",
    "dev": "node scripts/dev.mjs",
    "dev:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "seal": "tsx src/bin/enigma.ts seal",
    "check": "tsx src/bin/enigma.ts check",
    "guard": "tsx src/guard.ts --all",
    "verify": "npm run typecheck && npm run check && npm run guard",
    "prepublishOnly": "npm run verify && npm run build"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "ink": "^5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.29",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "codex",
    "opencode",
    "skills",
    "agents.md",
    "git-hooks",
    "secrets",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FJRG2007/enigma.git",
    "directory": "packages/enigma-cli"
  },
  "homepage": "https://github.com/FJRG2007/enigma#readme",
  "bugs": {
    "url": "https://github.com/FJRG2007/enigma/issues"
  },
  "author": "FJRG2007 <fjrg2007@tpeoficial.com>",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
