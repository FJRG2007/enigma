          ],
          "rewrite": {
            "@/core/search": "./search"
          },
          "main": true
        },
        {
          "path": "recipes/search/tailwind.tsx",
          "dest": "search/Search.tsx",
          "targets": [
            "react"
          ],
          "style": "tailwind"
        }
      ],
      "styles": false,
      "themeHooks": [
        "[data-enigma-search]"
