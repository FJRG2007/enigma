{
  "registry": "@enigmax/primitives",
  "version": 1,
  "kind": "primitive",
  "items": [
    {
      "name": "marquee",
      "title": "Draggable infinite marquee",
      "description": "Looping row that takes a speed in px/s, measures its own lap, and can be grabbed and thrown without swallowing the clicks on its items.",
      "targets": [
        "vanilla",
        "astro",
        "react"
      ],
      "entry": {
        "vanilla": "@enigmax/primitives",
        "astro": "@enigmax/primitives",
        "react": "@enigmax/primitives/react"
      },
      "exports": {
        "vanilla": [
          "createMarquee"
        ],
        "astro": [
          "createMarquee"
        ],
        "react": [
          "useMarquee"
        ]
      },
      "files": [
        {
          "path": "src/core/marquee.ts",
          "dest": "marquee.ts",
          "targets": [
            "vanilla",
            "astro",
            "react"
          ]
        },
        {
          "path": "src/react/use-marquee.ts",
          "dest": "use-marquee.ts",
          "targets": [
            "react"
          ],
          "rewrite": {
            "@/core/marquee": "./marquee"
          }
        },
        {
          "path": "recipes/marquee.tailwind.tsx",
          "dest": "Marquee.tsx",
          "targets": [
            "react"
          ],
          "style": "tailwind"
        },
        {
          "path": "recipes/marquee.css.tsx",
          "dest": "Marquee.tsx",
          "targets": [
            "react"
          ],
          "style": "css"
        },
        {
          "path": "recipes/marquee.css",
          "dest": "marquee.css",
          "targets": [
            "react",
            "vanilla",
            "astro"
          ],
          "style": "css"
        }
      ],
      "styles": false,
      "themeHooks": [
        "[data-enigma-marquee]",
        "[data-enigma-marquee][data-dragging]",
        "[data-enigma-marquee][data-hovering]",
        "[data-enigma-marquee][data-reduced-motion=true]",
        "[data-enigma-marquee-track]",
        "[data-enigma-marquee-copy]"
      ],
      "docs": "docs/notes/primitives.md#marquee",
      "recipes": [
        "tailwind",
        "css"
      ]
    },
    {
      "name": "input",
      "title": "Input affordances",
      "description": "In-field buttons with no styles of their own. A password field gets its reveal toggle automatically; the icon, label, side and container are all replaceable, and any other action plugs into the same mechanism.",
      "targets": [
        "vanilla",
        "astro",
        "react"
      ],
      "entry": {
        "vanilla": "@enigmax/primitives",
        "astro": "@enigmax/primitives",
        "react": "@enigmax/primitives/react"
      },
      "exports": {
        "vanilla": [
          "createInput"
        ],
        "astro": [
          "createInput"
        ],
        "react": [
          "useInput"
        ]
      },
      "files": [
        {
          "path": "src/core/input.ts",
          "dest": "input.ts",
          "targets": [
            "vanilla",
            "astro",
            "react"
          ]
        },
        {
          "path": "src/react/use-input.ts",
          "dest": "use-input.ts",
          "targets": [
            "react"
          ],
          "rewrite": {
            "@/core/input": "./input"
          }
        },
        {
          "path": "recipes/input.tailwind.tsx",
          "dest": "Field.tsx",
          "targets": [
            "react"
          ],
          "style": "tailwind"
        },
        {
          "path": "recipes/input.css.tsx",
          "dest": "Field.tsx",
          "targets": [
            "react"
          ],
          "style": "css"
        },
        {
          "path": "recipes/input.css",
          "dest": "input.css",
          "targets": [
            "react",
            "vanilla",
            "astro"
          ],
          "style": "css"
        }
      ],
      "styles": false,
      "themeHooks": [
        "[data-enigma-input]",
        "[data-enigma-input][data-enigma-input-reveal=on]",
        "[data-enigma-input-actions]",
        "[data-enigma-input-actions][data-position=start]",
        "[data-enigma-input-action]",
        "[data-enigma-input-action=reveal]"
      ],
      "docs": "docs/notes/primitives.md#input",
      "recipes": [
        "tailwind",
        "css"
      ]
    },
    {
      "name": "search",
      "title": "Search as you type",
      "description": "Search as you type, fuzzy by default with Fuse.js. Debouncing, ranking and cancellation are the primitive's; the matching is replaceable, and dropping Fuse falls back to a built-in accent-insensitive substring matcher.",
      "targets": [
        "vanilla",
        "astro",
        "react"
      ],
      "entry": {
        "vanilla": "@enigmax/primitives/search",
        "astro": "@enigmax/primitives/search",
        "react": "@enigmax/primitives/react"
      },
      "exports": {
        "vanilla": [
          "createSearch"
        ],
        "astro": [
          "createSearch"
        ],
        "react": [
          "useSearch"
        ]
      },
      "files": [
        {
          "path": "src/core/search.ts",
          "dest": "search.ts",
          "targets": [
            "vanilla",
            "astro",
            "react"
          ]
        },
        {
          "path": "src/react/use-search.ts",
          "dest": "use-search.ts",
          "targets": [
            "react"
          ],
          "rewrite": {
            "@/core/search": "./search"
          }
        },
        {
          "path": "recipes/search.tailwind.tsx",
          "dest": "Search.tsx",
          "targets": [
            "react"
          ],
          "style": "tailwind"
        }
      ],
      "styles": false,
      "themeHooks": [
        "[data-enigma-search]"
      ],
      "optionalDependencies": {
        "fuse.js": "Fuzzy matching. Omit it and a built-in substring matcher is used."
      },
      "docs": "docs/notes/primitives.md#search",
      "recipes": [
        "tailwind"
      ],
      "dependencies": {
        "fuse.js": "^7.0.0"
      }
    },
    {
      "name": "button",
      "title": "Button behaviour",
      "description": "Disabled, loading, a keyboard shortcut and a cooldown that can outlive a reload, collapsed into one `available` the renderer reads. An href reports an anchor rather than a button, so the framework's own Link stays your choice.",
      "targets": [
        "vanilla",
        "astro",
        "react"
      ],
      "entry": {
        "vanilla": "@enigmax/primitives",
        "astro": "@enigmax/primitives",
        "react": "@enigmax/primitives/react"
      },
      "exports": {
        "vanilla": [
          "createButton"
        ],
        "astro": [
          "createButton"
        ],
        "react": [
          "useButton"
        ]
      },
      "files": [
        {
          "path": "src/core/button.ts",
          "dest": "button.ts",
          "targets": [
            "vanilla",
            "astro",
            "react"
          ]
        },
        {
          "path": "src/react/use-button.ts",
          "dest": "use-button.ts",
          "targets": [
            "react"
          ],
          "rewrite": {
            "@/core/button": "./button"
          }
        }
      ],
      "styles": false,
      "themeHooks": [
        "[data-loading]",
        "[data-cooldown]",
        "[aria-disabled=true]",
        "[aria-busy=true]"
      ],
      "docs": "docs/notes/primitives.md#button"
    }
  ]
}
