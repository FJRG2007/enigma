{
  "name": "@enigmax/primitives",
  "version": "0.13.0",
  "description": "Headless components: the behaviour, the timing and the accessibility, with no styles of their own. Framework-agnostic core plus thin adapters.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./registry.json": "./registry.json",
    "./search": {
      "types": "./dist/search/index.d.ts",
      "import": "./dist/search/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js"
    },
    "./react-router": {
      "types": "./dist/react-router/index.d.ts",
      "import": "./dist/react-router/index.js"
    },
    "./relative-time.css": "./recipes/relative-time/styles.css",
    "./toast.css": "./recipes/toast/styles.css",
    "./input.css": "./recipes/input/styles.css"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:fixtures && node --test test/*.test.mjs && playwright test",
    "test:fixtures": "esbuild test/fixture/react.tsx --bundle --format=esm --jsx=automatic --outfile=test/fixture/build/react.js --tsconfig=tsconfig.json --alias:next/link=./test/fixture/next-link-stub.tsx --alias:react-router=./test/fixture/react-router-stub.tsx",
    "test:install": "playwright install chromium",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "files": [
    "dist",
    "src",
    "recipes",
    "registry.json",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@github/relative-time-element": ">=4",
    "fuse.js": ">=6",
    "next": ">=13",
    "react": ">=18",
    "react-router": ">=7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "fuse.js": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "@github/relative-time-element": {
      "optional": true
    }
  },
  "devDependencies": {
    "@github/relative-time-element": "^4.5.1",
    "@playwright/test": "^1.48.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.4",
    "fuse.js": "^7.0.0",
    "next": "^15.5.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "carousel",
    "enigma",
    "fuse",
    "headless",
    "input",
    "marquee",
    "network",
    "notifications",
    "password",
    "primitives",
    "react",
    "relative-time",
    "search",
    "toast",
    "unstyled",
    "vanilla"
  ],
  "license": "Apache-2.0",
  "author": "FJRG2007 <fjrg2007@tpeoficial.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FJRG2007/enigma.git",
    "directory": "packages/primitives"
  },
  "publishConfig": {
    "access": "public"
  }
}
