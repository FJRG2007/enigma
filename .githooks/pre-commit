#!/bin/sh
# This repo's pre-commit gate (deterministic layers - they catch what the
# Ciphera/security skills only persuade the agent to do):
#   1. enigma guard - blocks committed secrets, .env files, and dependency dirs.
#      Toggle protections in .githooks/enigma-guard.json.
#   2. enigma guardrails - blocks staged files that break code conventions
#      (e.g. non-UUID primary keys). Toggle with 'enigma config guardrails'.
#   3. Ciphera-style lint on the ADDED/MODIFIED lines of staged files (a ratchet):
#      new or edited lines must be clean; a file's pre-existing warnings do not block.
# Bypass once (all layers): git commit --no-verify
root="$(git rev-parse --show-toplevel)"

node "$root/.githooks/guard.mjs" "$@" || exit 1

node "$root/.githooks/guardrails.mjs" "$@" || exit 1

npm --prefix "$root" run -s lint:changed -- --staged || exit 1
